        "stem": [
          {
            "type": "text",
            "text": "Chester Zoo, in the United Kingdom, controls the European captive breeding programme for the eastern black rhinoceros, <i>Diceros bicornis michaeli</i>.",
            "source": {
              "qp": 21
            }
          },
          {
            "type": "text",
            "text": "Fig. 10.1 shows an eastern black rhinoceros.",
            "source": {
              "qp": 21
            }
          },
          {
            "type": "figure",
            "id": "fig10.1",
            "caption": "Fig. 10.1",
            "src": "figures/q10_fig10_1.png",
            "alt": "Eastern black rhinoceros.",
            "source": {
              "qp": 21
            }
          },
          {
            "type": "text",
            "text": "In the captive breeding programme for the eastern black rhinoceros, 15.8% of females breed each year while in the wild 23.7% of females breed each year.",
            "source": {
              "qp": 21
            }
          },
          {
            "type": "text",
            "text": "Suggest reasons why fewer females breed in captivity than in the wild.",
            "source": {
              "qp": 21
            }
          }
        ],
        "topics": [
          {
            "ref": "18.3(3)",
            "role": "primary"
          }
        ],
        "markScheme": {
