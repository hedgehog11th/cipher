            "id": "fig6.2",
            "caption": "Fig. 6.2",
            "src": "figures/q6_fig6_2.png",
            "alt": "Mean glomerular filtration rate for male and female age groups from 20–29 to 80–89 years.",
            "source": {
              "qp": 12
            }
          }
        ],
