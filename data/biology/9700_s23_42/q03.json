        "stem": [
          {
            "type": "text",
            "text": "The sea blush, <i>Plectritis congesta</i>, is a flowering plant that grows on the west coast of North America.",
            "source": {
              "qp": 5
            }
          },
          {
            "type": "text",
            "text": "Individual sea blush plants produce fruit that is either winged or wingless. Investigations have shown that this characteristic is controlled by a single gene with two alleles:",
            "source": {
              "qp": 5
            }
          },
          {
            "type": "list",
            "items": [
              "a dominant winged fruit allele",
              "a recessive wingless fruit allele."
            ],
            "source": {
              "qp": 5
            }
          },
          {
            "type": "text",
            "text": "Fig. 3.1 shows the difference in structure between winged fruit and wingless fruit phenotypes.",
            "source": {
              "qp": 5
            }
          },
          {
            "type": "figure",
            "id": "fig3.1",
            "caption": "Fig. 3.1",
            "src": "figures/q3_fig3_1.png",
            "alt": "Winged and wingless sea blush fruits with a two-millimetre scale.",
            "source": {
              "qp": 5
            }
          }
        ],
