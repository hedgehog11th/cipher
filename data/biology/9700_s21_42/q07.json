        "aiSupplement": {
          "explanation": [
            {
              "text": "An allele is a version of a gene, whereas dominance is a relationship between versions at the same locus. Define the two terms at those distinct levels and use the heterozygote to specify dominance.",
              "refs": [
                "ms:a#1",
                "ms:a#2",
                "syllabus:16.2(1)"
              ]
            }
          ],
          "reasoningChain": [
            "Define an allele in relation to a gene.",
            "Define dominance through its effect in a heterozygote."
          ],
          "inferredMistakes": []
        }
      },
