              "numberedInMs": false
            },
            {
              "n": 4,
              "text": "<b>4</b>  abiotic / physical / non-living, <b>and</b>, biotic / biological / living, factors / environment<b> ;</b> <b> </b>",
              "numberedInMs": false
            },
            {
              "n": 5,
              "text": "<b><i>5 </i></b> <i>idea that</i><b><i> </i></b>linked by, energy flow / mineral cycling / food webs / food chains / nutrient cycle <b>;</b>",
              "numberedInMs": false
