        "stem": [
          {
            "type": "text",
            "text": "Striated muscle contraction is explained by the sliding filament model.",
            "source": {
              "qp": 18
            }
          },
          {
            "type": "text",
            "text": "<b> </b> <b> </b> Outline the role of the proteins troponin and tropomyosin in the sliding filament model.",
            "source": {
              "qp": 18
            }
          }
        ],
        "marks": 4,
        "topics": [
          {
            "ref": "15.1(12)",
            "role": "primary"
          }
        ],
        "markScheme": {
          "marks": 4,
          "instruction": "<i>any </i><b><i>four</i></b><i> from: </i> <i> </i>",
          "guidance": [],
          "points": [
            {
              "n": 1,
              "text": "<b>1</b>  (at rest) tropomyosin, covers / AW, the binding sites on actin <b>;  </b> <b> </b> <b>R </b>active sites<b> </b>",
              "numberedInMs": false
            },
            {
              "n": 2,
              "text": "<b>2</b>  Ca<sup>2+</sup> binds to troponin <b>; </b>",
              "numberedInMs": false
            },
            {
              "n": 3,
              "text": "<b>3</b>  troponin changes shape <b>; </b>",
              "numberedInMs": false
            },
            {
              "n": 4,
              "text": "<b>4</b>  (causing) tropomyosin to move <b>;   </b> <b> </b>",
              "numberedInMs": false
            },
            {
              "n": 5,
              "text": "<b>5</b>  (so) exposes binding site <b>;</b>",
              "numberedInMs": false
            },
            {
              "n": 6,
              "text": "<b>6</b>  (so) myosin <u>head</u>, binds (to binding sites) / forms crossbridge <b>; </b>",
              "numberedInMs": false
            }
          ]
        },
        "er": [],
        "aiSupplement": {
          "explanation": [
            {
              "text": "Calcium exposes myosin-binding sites through the troponin–tropomyosin system. ATP permits detachment and supplies energy for further cross-bridge cycling; filament length remains constant.",
              "refs": [
                "syllabus:15.1(12)",
                "ms:b#1"
              ]
            }
          ],
          "reasoningChain": [
            "Trace calcium binding to exposure of actin sites.",
            "Follow attachment, movement, detachment and reactivation of myosin."
          ],
          "inferredMistakes": [
            {
              "text": "Saying that actin and myosin filaments shorten during contraction",
              "basis": "inferred",
              "refs": [
                "syllabus:15.1(12)"
              ]
            }
          ]
        },
        "type": "short"
      },
      {
