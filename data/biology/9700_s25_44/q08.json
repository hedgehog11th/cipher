        "stem": [
          {
            "type": "text",
            "text": "Striated muscles can sometimes become less efficient at contracting if they have been active for a long time. This is called muscle fatigue.",
            "source": {
              "qp": 19
            }
          },
          {
            "type": "text",
            "text": "<b> </b> <b> </b> Suggest why muscles may become fatigued.",
            "source": {
              "qp": 19
            }
          }
        ],
