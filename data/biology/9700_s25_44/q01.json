            {
              "n": 2,
              "text": "<b>2</b>  <i>ref. to</i> hypothalamus <b>; </b>",
              "numberedInMs": false
            },
            {
              "n": 3,
              "text": "<b>3</b>  hypothalamus produces (more) ADH <b>;</b> <b>A</b> neurosecretory cells produce ADH <b>R</b> secretion <b> </b>",
              "numberedInMs": false
            },
            {
              "n": 4,
              "text": "<b>4</b>  <u>posterior pituitary</u> releases (more) ADH (into blood) <b>; </b> <b> </b> <b>A</b> secretes <b>R</b> produces",
              "numberedInMs": false
