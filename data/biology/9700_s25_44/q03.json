    "stem": [
      {
        "type": "text",
        "text": "The genetics and evolution of the cat family, Felidae, have been studied by scientists.",
        "source": {
          "qp": 7
        }
      }
    ],
    "parts": [
      {
        "key": "a",
        "label": "(a)",
        "source": {
          "qp": 7
        },
        "stem": [
          {
            "type": "text",
            "text": "The domestic cat, <i>Felis catus</i>, is a popular pet.",
            "source": {
              "qp": 7
            }
          },
          {
            "type": "text",
            "text": "Fur length in <i>F. catus</i> is coded for by two alleles, <b>H</b> and <b>h</b>:",
            "source": {
              "qp": 7
            }
          },
          {
            "type": "list",
            "items": [
              "the allele for short hair, <b>H</b>, is dominant",
              "the allele for long hair, <b>h</b>, is recessive."
            ]
          }
        ],
        "parts": [
          {
            "key": "a.i",
            "label": "(i)",
            "source": {
              "qp": 7,
              "ms": 14
            },
            "stem": [
              {
                "type": "text",
                "text": "The population of domestic cats in a city was studied:",
                "source": {
                  "qp": 7
                }
              },
              {
                "type": "list",
                "items": [
                  "the population consisted of 15 000 cats",
                  "6.8% of these cats were long-haired."
                ]
              },
              {
                "type": "text",
                "text": "<b> </b>Calculate the percentage of cats in the city that were heterozygous for hair length.",
                "source": {
                  "qp": 7
                }
              },
              {
                "type": "text",
                "text": "You should use the Hardy–Weinberg equations in your calculation.",
                "source": {
                  "qp": 7
                }
              },
              {
                "type": "text",
                "text": "<i>p</i> + <i>q</i> = 1  <i>p</i><sup>2</sup> + 2<i>pq</i> + <i>q</i><sup>2</sup> = 1",
                "source": {
                  "qp": 7
                }
              },
              {
                "type": "text",
                "text": "<b> </b>Show your working.",
                "source": {
                  "qp": 7
                }
              },
              {
                "type": "answerLines",
                "labels": [
                  "answer ="
                ]
              }
            ],
            "marks": 3,
            "topics": [
              {
                "ref": "17.2(5)",
                "role": "primary"
              }
            ],
            "markScheme": {
              "marks": 3,
