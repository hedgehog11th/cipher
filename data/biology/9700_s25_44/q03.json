                {
                  "n": 5,
                  "text": "<b>and</b>  <b>38.6 / 39</b> (%) <b>;</b>",
                  "numberedInMs": false
                }
              ]
            },
            "er": [],
            "aiSupplement": {
              "explanation": [
                {
                  "text": "Under Hardy–Weinberg assumptions, recessive phenotype frequency equals q squared. Find q before deriving p and the heterozygote frequency; convert percentages to proportions first.",
