                  "numberedInMs": false
                },
                {
                  "n": 2,
                  "text": "<i> </i> <i>q</i> = 0.260768 <b>; </b>",
                  "numberedInMs": false
                },
                {
                  "n": 3,
                  "text": "<i> </i> <i>p</i> = 0.739232 <b>;</b>",
                  "numberedInMs": false
                },
                {
                  "n": 4,
                  "text": "2<i>pq</i> = 0.385536 <b>;</b>",
                  "numberedInMs": false
