            },
            {
              "n": 4,
              "text": "<b>4</b>  spotted, allele / mutation, passed on (to offspring) <b>;</b>",
              "numberedInMs": false
            },
            {
              "n": 5,
              "text": "<b>5</b>  spotted, allele / mutation, frequency increased <b>; </b>",
              "numberedInMs": false
            }
          ]
        },
