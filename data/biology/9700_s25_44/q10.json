        "stem": [
          {
            "type": "text",
            "text": "Hummingbirds feed on nectar from flowers. Nectar is rich in sugars.",
            "source": {
              "qp": 22
            }
          },
          {
            "type": "text",
            "text": "Fig. 10.1 shows a hummingbird.",
