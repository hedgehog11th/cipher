                  "qp": 12
                }
              }
            ],
            "marks": 2,
            "markScheme": {
              "marks": 2,
              "instruction": null,
              "guidance": [],
              "points": [
                {
                  "n": 1,
                  "text": "(excess) amino acids, deaminated / have amino group removed <b>; </b>"
