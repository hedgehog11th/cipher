            "source": {
              "qp": 12,
              "ms": 10
            },
            "stem": [
              {
                "type": "text",
                "text": "Homeostatic control of the water potential of blood includes receptors, effectors and target cells.",
                "source": {
                  "qp": 12
                }
              },
              {
                "type": "text",
                "text": "Identify the names <b>and</b> locations of these components of homeostatic control in osmoregulation.",
                "source": {
                  "qp": 12
                }
              }
            ],
            "marks": 3,
            "markScheme": {
              "marks": 3,
              "instruction": "<i>any </i><b><i>three</i></b><i> from: </i>",
              "guidance": [],
              "points": [
                {
                  "n": 1,
                  "text": "osmoreceptors in hypothalamus (detect change / are receptors) <b>;</b>"
                },
                {
                  "n": 2,
                  "text": "effector(s): collecting duct / distal convoluted tubule / nephron <b>; </b>"
                },
                {
                  "n": 3,
                  "text": "target cells: collecting duct (cells) <b>; </b>"
                }
              ]
            },
            "er": [],
            "topics": [
              {
                "ref": "14.1(8)",
                "role": "primary"
              }
            ],
            "aiSupplement": {
              "explanation": [
                {
                  "text": "Osmoreceptors detect changes in blood water potential in the hypothalamus. Responses in the distal nephron and collecting ducts alter water reabsorption, so the anatomical location matters as well as the component name.",
                  "refs": [
                    "ms:a.ii#1",
                    "ms:a.ii#2",
                    "ms:a.ii#3",
                    "syllabus:14.1(8)"
                  ]
                }
              ],
              "reasoningChain": [
                "Identify the receptor and its location.",
                "Identify the renal structures and target cells that alter water reabsorption."
              ],
              "inferredMistakes": [
                {
                  "text": "Naming ADH itself as an osmoreceptor.",
                  "basis": "inferred",
                  "refs": [
                    "ms:a.ii#1",
                    "ms:a.ii#2",
                    "ms:a.ii#3",
                    "syllabus:14.1(8)"
                  ]
                }
              ]
            },
            "type": "extended"
          }
        ]
      },
