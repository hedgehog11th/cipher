        "type": "text",
        "text": "The mammalian kidney is responsible for:",
        "source": {
          "qp": 12
        }
      },
      {
        "type": "list",
        "items": [
          "the excretion of urea",
          "osmoregulation (the homeostatic control of the water potential of the blood)."
        ]
      }
    ],
