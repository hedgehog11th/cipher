          {
            "type": "text",
            "text": "The glomerulus and Bowman’s capsule of the nephron are important in the formation of urine.",
            "source": {
              "qp": 12
            }
          },
          {
            "type": "text",
            "text": "Outline the role of the glomerulus and Bowman’s capsule in the formation of urine.",
            "source": {
              "qp": 12
            }
          }
        ],
        "marks": 3,
        "markScheme": {
          "marks": 3,
          "instruction": "<i>any </i><b><i>three</i></b><i> from: </i>",
          "guidance": [],
          "points": [
            {
              "n": 1,
              "text": "ultrafiltration / forms glomerular filtrate <b>; </b>"
            },
            {
              "n": 2,
              "text": "high, hydrostatic / blood, <u>pressure</u> in, glomerulus / capillaries <b>; </b>"
            },
            {
              "n": 3,
              "text": "so, water / (named) solutes, move (out of glomerulus / into Bowman’s capsule) <b>; </b>"
            },
            {
              "n": 4,
              "text": "through <i>two of</i>: fenestrae / fenestrations<br>basement membrane<br>slit pores / filtration slits / between podocytes <b>; </b>"
            },
            {
              "n": 5,
              "text": "AVP <b>;</b>"
            }
          ]
        },
