            "stem": [
              {
                "type": "text",
                "text": "A student planned a method to measure the relative abundance of <i>Usnea</i> and <i>Xanthoria</i> on trees along a transect from the town centre at 0 km to unpolluted countryside at 4 km.",
                "source": {
                  "qp": 21
                }
              },
              {
                "type": "text",
                "text": "Suggest why measuring the relative abundance of the two types of lichen gives information that is useful for conservation.",
                "source": {
                  "qp": 21
                }
              }
            ],
            "marks": 3,
            "markScheme": {
              "marks": 3,
              "instruction": "<i>any </i><b><i>three</i></b><i> from: </i>",
              "guidance": [],
              "points": [
