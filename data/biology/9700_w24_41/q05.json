        },
        "stem": [
          {
            "type": "text",
            "text": "Structures <b>A</b> and <b>B</b> and the thallus of <i>L. cruciata</i> are haploid.",
            "source": {
              "qp": 10
            }
          },
          {
            "type": "text",
            "text": "Explain what is meant by haploid.",
            "source": {
              "qp": 10
            }
          }
        ],
        "marks": 2,
        "markScheme": {
          "marks": 2,
          "instruction": "<i>any </i><b><i>two</i></b><i> from: </i>",
          "guidance": [],
          "points": [
            {
              "n": 1,
              "text": "one / single, set of chromosomes <b>; </b>"
