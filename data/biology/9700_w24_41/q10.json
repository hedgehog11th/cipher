    "stem": [
      {
        "type": "text",
        "text": "Populations of the moth <i>Biston betularia</i> live in Europe and in North America. The most common phenotype on both continents is a pale wing colour with light‑grey shading (the typical form).",
        "source": {
          "qp": 22
        }
      },
      {
        "type": "text",
        "text": "A moth phenotype with dark wing colour (the melanic form) also occurs on both continents.",
        "source": {
          "qp": 22
        }
      },
      {
        "type": "text",
        "text": "Fig. 10.1 shows the typical form of the moth.",
        "source": {
          "qp": 22
        }
      },
      {
        "type": "text",
        "text": "Fig. 10.2 shows the melanic form of the moth.",
        "source": {
          "qp": 22
        }
      },
      {
        "type": "figure",
        "id": "fig10.1_10.2",
        "caption": "<b>Fig. 10.1　　Fig. 10.2</b>",
        "src": "figures/q10_fig10_1_10_2.png",
        "alt": "Typical pale and melanic dark forms of Biston betularia.",
        "source": {
          "qp": 22
        }
      }
    ],
    "parts": [
