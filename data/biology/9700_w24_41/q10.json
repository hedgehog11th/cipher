        },
        "stem": [
          {
            "type": "text",
            "text": "A light trap was used to estimate the total size of a population of <i>B. betularia</i> in a woodland. On night one, 24 moths were captured. These were marked with a small spot of harmless paint. On night two, 29 moths were captured, and 8 of these showed a spot of paint.",
            "source": {
              "qp": 24
            }
          },
          {
            "type": "text",
            "text": "Use the Lincoln index formula provided to calculate the size of the population.",
            "source": {
              "qp": 24
            }
          },
          {
            "type": "text",
            "text": "Show your working.",
            "source": {
              "qp": 24
            }
          },
          {
            "type": "figure",
            "id": "lincoln",
            "caption": "Lincoln index formula",
            "src": "figures/q10_lincoln.png",
            "alt": "Lincoln index formula and definitions of N, n1, n2 and m2.",
            "source": {
              "qp": 24
            }
          },
          {
            "type": "answerLines",
            "labels": [
              "population size ="
            ]
          }
        ],
        "marks": 2,
        "markScheme": {
          "marks": 2,
          "instruction": null,
          "guidance": [],
          "points": [
            {
              "n": 1,
              "text": "(24 × 29) ÷ 8 <b>;</b>",
              "numberedInMs": false
            },
            {
              "n": 2,
              "text": "= 87<b> ; </b>",
              "numberedInMs": false
            }
          ]
        },
        "er": [],
        "topics": [
          {
            "ref": "18.2(4)",
            "role": "primary"
          }
        ],
        "aiSupplement": {
          "explanation": [
            {
              "text": "This calculation has no separate syllabus outcome: it applies the mark-release-recapture method in 18.2(4). Substitute the first and second sample sizes and the number of marked recaptures into the supplied Lincoln index.",
              "refs": [
                "ms:d#1",
                "ms:d#2",
                "syllabus:18.2(4)"
              ]
            }
          ],
          "reasoningChain": [
            "Multiply 24 by 29.",
            "Divide by the eight marked moths recaptured to estimate 87 moths."
          ],
          "inferredMistakes": [
            {
              "text": "Using the unmarked individuals in the second sample as the denominator.",
              "basis": "inferred",
              "refs": [
                "ms:d#1",
