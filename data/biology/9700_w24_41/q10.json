        },
        "stem": [
          {
            "type": "text",
            "text": "Two melanic European moths were crossed together. The wing colours of the offspring were 15 typical and 41 melanic.",
            "source": {
              "qp": 22
            }
          },
          {
            "type": "text",
            "text": "Construct a genetic diagram to explain these results. You may use the symbols <b>A</b> and <b>a</b> to represent the alleles.",
            "source": {
              "qp": 22
            }
          }
        ],
        "marks": 3,
        "markScheme": {
          "marks": 3,
          "instruction": null,
          "guidance": [],
