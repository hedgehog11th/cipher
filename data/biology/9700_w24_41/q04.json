        "stem": [
          {
            "type": "text",
            "text": "The rate of photosynthesis decreases by 40% when the leaves of <i>M. pudica</i> close.",
            "source": {
              "qp": 9
            }
          },
          {
            "type": "text",
            "text": "Explain why the rate of photosynthesis decreases when the leaves of <i>M. pudica</i> close.",
            "source": {
              "qp": 9
            }
          }
        ],
        "marks": 2,
        "markScheme": {
