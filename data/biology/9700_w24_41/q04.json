              "n": 1,
              "text": "less / decreased, surface area (of leaf exposed) <b>; </b>"
            },
            {
              "n": 2,
              "text": "less light absorbed by, chloroplasts / thylakoid membranes / grana / pigments / chlorophyll / light harvesting  complexes / photosystems <b>;</b>"
            },
            {
              "n": 3,
              "text": "fewer stomata, exposed / available(to air) <b>; </b>"
            },
            {
              "n": 4,
              "text": "less carbon dioxide, enters / absorbed <b>;</b>"
            }
          ]
        },
        "er": [],
