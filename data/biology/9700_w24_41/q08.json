        "stem": [
          {
            "type": "text",
            "text": "Sometimes the gene for genetic engineering cannot be extracted from the donor organism. Instead, the gene is synthesised using one of two different methods.",
            "source": {
              "qp": 18
            }
          },
          {
            "type": "text",
            "text": "Outline the <b>two</b> methods for synthesising a gene for use in genetic engineering.",
            "source": {
              "qp": 18
            }
          }
        ],
        "marks": 3,
        "markScheme": {
          "marks": 3,
          "instruction": "<i>any </i><b><i>three</i></b><i> from</i>:",
          "guidance": [],
          "points": [
            {
              "n": 1,
              "text": "make cDNA from, messenger RNA / mRNA <b>; </b>"
            },
            {
              "n": 2,
              "text": "using reverse transcriptase <b>; </b>"
            },
            {
              "n": 3,
              "text": "synthesise (gene chemically) from <u>nucleotides</u> / join <u>nucleotides</u><b> ; </b>"
            },
            {
              "n": 4,
              "text": "(using known) amino acid / nucleotide, sequence from database <b>;</b>"
            }
          ]
        },
        "er": [],
        "topics": [
