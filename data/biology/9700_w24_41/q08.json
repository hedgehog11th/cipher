        ],
        "aiSupplement": {
          "explanation": [
            {
              "text": "The temperature sequence separates DNA strands, allows primers to anneal and then allows thermostable DNA polymerase to extend from the primers. Primer binding must precede extension.",
              "refs": [
                "ms:c#1",
                "ms:c#2",
                "ms:c#3",
