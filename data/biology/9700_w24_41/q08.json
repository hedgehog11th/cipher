        },
        "stem": [
          {
            "type": "text",
            "text": "The polymerase chain reaction (PCR) is used to make many copies of a gene.",
            "source": {
              "qp": 19
            }
          },
          {
            "type": "text",
            "text": "Three temperatures are used in a PCR cycle.",
            "source": {
              "qp": 19
            }
          },
          {
            "type": "text",
            "text": "State the three temperatures that are used, <b>and</b> outline what happens at each temperature during a PCR cycle.",
            "source": {
              "qp": 19
            }
          }
        ],
        "marks": 3,
        "markScheme": {
          "marks": 3,
          "instruction": null,
          "guidance": [],
          "points": [
            {
              "n": 1,
              "text": "90–98<sup>o</sup>C – DNA, denatures / strands separate <b>;</b>"
            },
            {
              "n": 2,
              "text": "50–65<sup>o</sup>C – primers, bind / base pair / anneal (to DNA) <b>; </b>"
            },
            {
              "n": 3,
              "text": "68–75<sup>o</sup>C – Taq / DNA, polymerase, makes, DNA / (new) strand <b>; </b>"
            }
          ]
        },
        "er": [],
        "topics": [
          {
