              "ms": 6
            },
            "stem": [
              {
                "type": "text",
                "text": "The rat motor neurone has an impulse transmission speed of 50 m s<sup>–1</sup>. The snail motor neurone has an impulse transmission speed of 8 m s<sup>–1</sup>.",
                "source": {
                  "qp": 2
                }
              },
              {
                "type": "text",
                "text": "Explain why the rat motor neurone has a faster impulse transmission speed than the snail motor neurone.",
                "source": {
                  "qp": 2
                }
              }
            ],
            "marks": 2,
            "markScheme": {
              "marks": 2,
              "instruction": null,
              "guidance": [],
              "points": [
                {
                  "n": 1,
                  "text": "rat has, myelin sheath / Schwann cell / myelinated axon / myelinated neurone <b>; </b>"
                },
                {
                  "n": 2,
                  "text": "(rat has) saltatory conduction <b>OR</b> (rat)impulse / action potential, jumps / leaps / AW, from (one) <u>node of Ranvier</u> to, the next / another <b>;</b>"
                }
              ]
            },
            "er": [],
            "topics": [
              {
                "ref": "15.1(7)",
                "role": "primary"
              }
            ],
            "aiSupplement": {
              "explanation": [
                {
                  "text": "Myelin insulates the rat axon, so depolarisation is regenerated at nodes of Ranvier. This saltatory conduction explains the faster transmission despite the rat axon’s smaller diameter.",
                  "refs": [
                    "ms:a.ii#1",
                    "ms:a.ii#2",
                    "syllabus:15.1(7)"
                  ]
                }
              ],
              "reasoningChain": [
                "Identify the myelinated axon.",
                "Link myelination to saltatory conduction between nodes."
              ],
              "inferredMistakes": [
                {
                  "text": "Explaining the faster rat impulse by claiming that its axon has a larger diameter.",
                  "basis": "inferred",
                  "refs": [
                    "ms:a.ii#1",
                    "ms:a.ii#2",
                    "syllabus:15.1(7)"
                  ]
                }
              ]
            },
            "type": "short"
          }
        ]
