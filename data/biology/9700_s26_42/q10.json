        "stem": [
          {
            "type": "text",
            "text": "Chloroplast pigments can be separated and identified by a technique called chromatography.",
            "source": {
              "qp": 25
            }
          },
          {
            "type": "text",
            "text": "A student carried out an investigation using paper chromatography to separate the pigments in a solution containing two chloroplast pigments.",
            "source": {
              "qp": 25
            }
          },
          {
            "type": "text",
            "text": "The results of the investigation are shown in Figure 10.2.",
            "source": {
              "qp": 25
            }
          },
          {
            "type": "figure",
            "id": "fig10.2",
            "caption": "Figure 10.2",
            "src": "figures/q10_fig10_2.png",
            "alt": "Paper chromatogram showing solvent front, pigments A and B and a centimetre scale.",
            "source": {
              "qp": 25
            }
          }
        ],
