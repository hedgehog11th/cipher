        "stem": [
          {
            "type": "text",
            "text": "In humans the  <i>TYR</i> gene is involved in the production of a dark pigment, melanin, in some cells.",
            "source": {
              "qp": 16
            }
          },
          {
            "type": "text",
            "text": "Describe how the expression of the <i>TYR</i> gene leads to the production of melanin.",
            "source": {
              "qp": 16
            }
          }
        ],
        "topics": [
          {
            "ref": "16.2(6)",
            "role": "primary"
          }
        ],
        "markScheme": {
