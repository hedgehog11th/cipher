          "instruction": "<i>any </i><b><i>three</i></b><i> from: </i>",
          "guidance": [],
          "points": [
            {
              "n": 1,
              "text": "<i>TYR</i> codes for <u>tyrosinase</u> <b>; </b>"
            },
            {
              "n": 2,
              "text": "converts tyrosine into DOPA <b>; </b>"
            },
            {
              "n": 3,
              "text": "converts DOPA into dopaquinone <b>; </b>"
            },
            {
              "n": 4,
              "text": "dopaquinone converted to melanin <b>; </b>"
            }
          ],
          "source": {
            "ms": 16
          }
