        "stem": [
          {
            "type": "text",
            "text": "<i>Petunia</i> <i>axillaris</i> is a plant with flowers that are pollinated by night-flying moths. To attract moths, <i>P.</i> <i>axillaris</i> synthesises compounds at night that are released as scents (attractive smells).",
            "source": {
              "qp": 20
            }
          },
          {
            "type": "text",
            "text": "Figure 8.1 shows a flower of <i>P.</i> <i>axillaris</i>.",
            "source": {
              "qp": 20
            }
          },
          {
            "type": "text",
            "text": "Figure 8.2 shows a moth with large sensory structures known as antennae.",
            "source": {
              "qp": 20
            }
          },
          {
            "type": "figure",
            "id": "fig8.1_8.2",
            "caption": "Figure 8.1   Figure 8.2",
            "src": "figures/q8_fig8_1_8_2.png",
            "alt": "Petunia axillaris flower and a moth with large antennae.",
            "source": {
              "qp": 20
            }
          }
        ],
        "parts": [
          {
            "key": "a.i",
            "label": "(i)",
            "source": {
              "qp": 20,
              "ms": 20
            },
            "stem": [
              {
                "type": "text",
                "text": "Moths detect scent chemicals using sensory receptor cells on their antennae.",
                "source": {
                  "qp": 20
