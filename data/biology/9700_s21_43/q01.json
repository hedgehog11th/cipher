        "stem": [
          {
            "type": "text",
            "text": "When a mammal dies, aerobic respiration stops. The striated muscles contract and remain contracted for a few hours after death.",
            "source": {
              "qp": 3
            }
          },
          {
            "type": "text",
            "text": "Suggest why the muscles remain contracted for a few hours.",
            "source": {
              "qp": 3
            }
          }
        ],
        "topics": [
          {
            "ref": "15.1(12)",
            "role": "primary"
          }
        ],
        "markScheme": {
          "instruction": null,
          "guidance": [],
          "source": {
            "ms": 5
          },
          "points": [
            {
              "n": 1,
              "text": "no / little, ATP, produced / available <b>; </b>",
              "numberedInMs": false
            },
            {
              "n": 2,
              "text": "(so) no breaking of cross bridges / myosin head not released <b>; </b>",
              "numberedInMs": false
            }
          ],
          "marks": 2
        },
        "er": [
          "er.q1.c"
        ],
        "aiSupplement": {
          "explanation": [
            {
              "text": "Detachment and force generation are different parts of the cross-bridge cycle. ATP binding is required for detachment, so the absence of ATP can leave an existing attachment in place.",
              "refs": [
                "ms:c#1",
                "ms:c#2",
                "syllabus:15.1(12)"
              ]
            }
          ],
          "reasoningChain": [
            "Identify which step of the cycle requires fresh ATP.",
            "Relate its failure to the sustained attachment."
          ],
          "inferredMistakes": []
        }
