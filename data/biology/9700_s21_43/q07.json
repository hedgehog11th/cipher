            "markScheme": {
              "instruction": null,
              "guidance": [],
              "source": {
                "ms": 16
              },
              "points": [
                {
                  "n": 1,
                  "text": "both alleles, contribute to / expressed in, the phenotype (in the heterozygote) <b>; </b>",
                  "numberedInMs": false
                }
              ],
              "marks": 1
            },
            "er": [
              "er.q7.b.i"
            ],
            "aiSupplement": {
              "explanation": [
                {
                  "text": "Codominance describes expression of both alleles in a heterozygote. It does not mean that both alleles must produce identical amounts of a protein or that every possible disease symptom must be equally severe.",
                  "refs": [
                    "ms:b.i#1",
                    "syllabus:16.2(1)"
                  ]
                }
              ],
              "reasoningChain": [
                "Identify the heterozygous condition.",
                "State how the two alleles contribute to the phenotype."
              ],
              "inferredMistakes": []
            }
          },
          {
            "key": "b.ii",
            "label": "(ii)",
            "type": "short",
            "marks": 1,
            "source": {
              "qp": 18,
              "ms": 16
            },
            "stem": [
              {
                "type": "text",
                "text": "A person who is heterozygous will have sickle cell trait but may not experience the symptoms of sickle cell anaemia.",
                "source": {
                  "qp": 18
                }
              },
              {
                "type": "text",
                "text": "Suggest why a person with sickle cell trait may not show the symptoms of sickle cell anaemia.",
                "source": {
                  "qp": 18
                }
              }
            ],
            "topics": [
              {
                "ref": "16.2(6)",
                "role": "primary"
