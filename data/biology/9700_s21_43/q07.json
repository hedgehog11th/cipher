            },
            "stem": [
              {
                "type": "text",
                "text": "Explain what is meant by the alleles being codominant.",
                "source": {
                  "qp": 18
                }
              }
            ],
            "topics": [
              {
                "ref": "16.2(1)",
                "role": "primary"
