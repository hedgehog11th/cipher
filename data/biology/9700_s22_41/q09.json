          "guidance": [],
          "points": [
            {
              "n": 1,
              "text": "H<sup>+</sup> pumped, out of guard cell / into cell wall of guard cell <b>; </b>"
            },
            {
              "n": 2,
              "text": "inside of cell becomes (relatively) negatively charged <b>; </b>"
            },
            {
              "n": 3,
              "text": "K<sup>+</sup> enters cell by facilitated diffusion <b>; </b>"
