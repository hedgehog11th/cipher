        "er": [
          "er.q6.a"
        ],
        "aiSupplement": {
          "explanation": [
            {
              "text": "A control mechanism compares a physiological variable with its normal range and produces a response that opposes a deviation. The individual metabolic pathways are responses within that mechanism.",
