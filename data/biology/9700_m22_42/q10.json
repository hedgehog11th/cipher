        "stem": [
          {
            "type": "text",
            "text": "In times of water stress, abscisic acid is released. This results in the closure of stomata to reduce water loss by transpiration.",
            "source": {
              "qp": 27
            }
          },
          {
            "type": "text",
            "text": "Describe the role of abscisic acid in stomatal closure.",
            "source": {
              "qp": 27
            }
          }
        ],
        "topics": [
          {
            "ref": "14.2(4)",
            "role": "primary"
          },
          {
            "ref": "14.2(3)",
            "role": "secondary"
          }
        ],
        "markScheme": {
          "marks": 4,
          "instruction": "<i>any </i><b><i>four</i></b><i> from: </i>",
          "guidance": [],
          "points": [
            {
              "n": 1,
              "text": "abscisic acid binds to receptors on cell surface membrane (of guard cell) <b>;</b>"
            },
            {
              "n": 2,
              "text": "proton pumps are inhibited / AW <b>;</b>"
            },
            {
              "n": 3,
              "text": "stimulates Ca<sup>2+</sup> uptake <b>/</b> opens Ca<sup>2+</sup> channels <b>; </b>"
            },
            {
              "n": 4,
              "text": "Ca<sup>2+</sup> acts as second messenger <b>;</b>"
            },
            {
              "n": 5,
              "text": "K<sup>+</sup> diffuses out of the (guard) cell <b>;</b>"
            },
            {
              "n": 6,
              "text": "water potential of (guard) cell increases <b>;</b>"
            },
            {
              "n": 7,
              "text": "water leaves (guard) cell, by osmosis / down water potential gradient <b>;</b>"
            },
            {
              "n": 8,
              "text": "(guard) cell becomes flaccid / cell volume decreases (so stoma closes) <b>; </b>"
            }
          ],
          "source": {
            "ms": 22
          }
        },
        "er": [
          "er.q10.b"
        ],
        "aiSupplement": {
          "explanation": [
            {
              "text": "Loss of potassium ions makes the guard-cell water potential less negative. Water then leaves by osmosis, reducing turgor and changing cell shape so that the pore closes. Calcium carries the signal from membrane receptors to downstream responses.",
              "refs": [
                "ms:b#1",
                "ms:b#3",
                "ms:b#4",
                "ms:b#5",
                "ms:b#6",
                "ms:b#7",
                "ms:b#8"
              ]
            }
          ],
          "reasoningChain": [
            "Start at the ABA receptor.",
            "Link calcium signalling to solute loss.",
            "Connect water potential to osmosis and reduced turgor."
          ],
