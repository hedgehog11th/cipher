            "ref": "18.1(1)",
            "role": "primary"
          }
        ],
        "markScheme": {
          "marks": 3,
          "instruction": null,
          "guidance": [],
          "points": [
            {
              "n": 1,
              "text": "individuals (within a population) can, breed / mate / reproduce <b>;</b>"
            },
            {
              "n": 2,
              "text": "to produce fertile offspring <b>;</b>"
            },
            {
              "n": 3,
              "text": "are reproductively isolated (from other species) / AW <b>;</b>"
            }
          ],
          "source": {
            "ms": 20
          }
        },
        "er": [
          "er.q9.a"
        ],
        "aiSupplement": {
          "explanation": [
            {
              "text": "The biological concept uses reproductive compatibility within a group and reproductive isolation from other groups. A superficial resemblance alone does not establish this concept.",
              "refs": [
                "ms:a#1",
                "ms:a#2",
                "ms:a#3"
              ]
            }
          ],
          "reasoningChain": [
            "Describe reproduction within the group.",
            "Specify fertile offspring.",
            "Include isolation from other species."
          ],
          "inferredMistakes": []
        }
      },
      {
        "key": "b",
        "label": "(b)",
        "type": "short",
