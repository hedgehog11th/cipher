        },
        "stem": [
          {
            "type": "text",
            "text": "Compare the characteristics of members of the domain Archaea with the characteristics of members of the domain Bacteria.",
            "source": {
              "qp": 26
            }
          },
          {
            "type": "text",
            "text": "Include similarities and differences.",
            "source": {
              "qp": 26
            }
          }
        ],
        "topics": [
          {
            "ref": "18.1(3)",
            "role": "primary"
          },
          {
            "ref": "18.1(2)",
            "role": "secondary"
          }
        ],
        "markScheme": {
          "marks": 4,
          "instruction": "<i>any </i><b><i>four</i></b><i> from: </i><br><i>max </i><b><i>three</i></b><i>: </i>",
          "guidance": [],
          "points": [
            {
              "n": 1,
              "text": "both are prokaryotes<br><b>or </b><br> both have no, nucleus / (double) membrane-bound organelles <b>;</b>"
            },
            {
              "n": 2,
              "text": "both have circular DNA <b>;</b>"
            },
            {
              "n": 3,
              "text": "both have 70S ribosomes <b>;</b>"
            },
            {
              "n": 4,
              "text": "both reproduce by, binary fission / budding / fragmentation <b>; </b>"
            },
            {
              "n": 5,
              "text": "<i>max </i><b><i>three</i></b><i>: </i><br>bacteria cell wall made of peptidoglycan whereas Archaea cell wall does not have peptidoglycan <b>;</b>"
            },
            {
              "n": 6,
              "text": "bacteria cell membrane has ester-linked lipids whereas Archaea cell membrane has ether-linked lipids <b>;</b>"
            },
            {
              "n": 7,
              "text": "have different ribosomal RNA <b>; </b>"
            },
            {
              "n": 8,
              "text": "Bacteria do not have (DNA associated with) histones whereas Archaea do have (DNA associated with) histones <b>;</b>"
            },
            {
              "n": 9,
              "text": "Bacteria form spores whereas Archaea do not form spores <b>;</b>"
            }
          ],
          "source": {
            "ms": 21
          }
        },
        "er": [
