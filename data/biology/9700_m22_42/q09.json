        },
        "stem": [
          {
            "type": "text",
            "text": "Suggest when the morphological species concept is more useful than the biological species concept.",
            "source": {
              "qp": 26
            }
          }
        ],
        "topics": [
          {
            "ref": "18.1(1)",
            "role": "primary"
          }
        ],
        "markScheme": {
          "marks": 1,
          "instruction": "<i>any </i><b><i>one</i></b><i> from:</i>",
          "guidance": [],
          "points": [
            {
              "n": 1,
              "text": "for organisms that, do not breed sexually / are asexual <b>; </b>"
            },
            {
              "n": 2,
              "text": "for, fossil / extinct, organisms <b>; </b>"
            },
            {
              "n": 3,
              "text": "morphological differences are easier to determine <b>;</b>"
            },
            {
              "n": 4,
              "text": "often not possible to observe reproductive behaviour <b>;</b>"
            },
            {
              "n": 5,
              "text": "time required for mating behaviour may take too long (to be observed) / not possible to achieve conditions in which mating can occur (while being observed) <b>; </b>"
            }
          ],
          "source": {
            "ms": 20
          }
        },
        "er": [
          "er.q9.b"
        ],
        "aiSupplement": {
          "explanation": [
            {
              "text": "A reproductive criterion is difficult or impossible to apply when mating cannot be observed or does not occur. Preserved structures may then provide the available basis for identifying distinct forms.",
              "refs": [
                "ms:b#1",
                "ms:b#2",
                "ms:b#4",
                "ms:b#5"
              ]
            }
          ],
          "reasoningChain": [
            "Identify a case where breeding evidence is unavailable.",
            "Explain why morphology can still be assessed."
          ],
          "inferredMistakes": []
        }
      },
