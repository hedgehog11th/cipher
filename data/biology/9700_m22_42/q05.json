            "er": [
              "er.q5.b.i"
            ],
            "aiSupplement": {
              "explanation": [
                {
                  "text": "The direction RNA template to DNA product identifies the reverse-transcription reaction. The product can then be used in recombinant DNA work.",
                  "refs": [
                    "ms:b.i#1"
                  ]
                }
              ],
              "reasoningChain": [
                "Identify the nucleic acid template.",
                "Select the enzyme that synthesises DNA from it."
