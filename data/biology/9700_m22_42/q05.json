        "stem": [
          {
            "type": "text",
            "text": "The gene that codes for human factor VIII can be transferred into mammalian cells in tissue culture.",
            "source": {
              "qp": 17
            }
          },
          {
            "type": "text",
            "text": "Explain why a promoter also needs to be transferred into the mammalian cells so that human factor VIII can be synthesised.",
            "source": {
              "qp": 17
            }
          }
        ],
        "topics": [
          {
            "ref": "19.1(5)",
            "role": "primary"
          }
        ],
        "markScheme": {
          "marks": 2,
          "instruction": "<i>any </i><b><i>two</i></b><i> from: </i>",
          "guidance": [],
          "points": [
            {
              "n": 1,
              "text": "required, for gene expression / to start transcription <b>; </b>"
            },
            {
              "n": 2,
              "text": "(so) transcription factor can bind (to promoter) <b>;</b>"
            },
            {
              "n": 3,
              "text": "so RNA polymerase can bind (to promoter) <b>;</b>"
            }
          ],
          "source": {
            "ms": 15
          }
        },
        "er": [
          "er.q5.c"
        ],
        "aiSupplement": {
          "explanation": [
            {
              "text": "The coding sequence specifies the polypeptide, while the promoter recruits the machinery that initiates transcription. Transferring coding DNA alone does not guarantee that the recipient cell will transcribe it.",
              "refs": [
                "ms:c#1",
                "ms:c#2",
                "ms:c#3"
              ]
            }
          ],
          "reasoningChain": [
            "Distinguish regulatory DNA from coding DNA.",
            "Connect promoter binding to initiation of transcription."
          ],
          "inferredMistakes": []
        }
