        },
        "stem": [
          {
            "type": "text",
            "text": "The gene that codes for human factor VIII can be synthesised from messenger RNA purified from human liver cells.",
            "source": {
              "qp": 16
            }
          }
        ],
        "parts": [
          {
            "key": "b.i",
            "label": "(i)",
            "type": "short",
            "marks": 1,
            "source": {
              "qp": 16,
              "ms": 15
            },
            "stem": [
              {
                "type": "text",
                "text": "Name the enzyme that uses messenger RNA as a template to produce complementary DNA.",
                "source": {
                  "qp": 16
                }
              }
            ],
            "topics": [
              {
                "ref": "19.1(4)",
                "role": "primary"
