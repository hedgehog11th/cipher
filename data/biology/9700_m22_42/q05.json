            },
            "er": [
              "er.q5.b.ii"
            ],
            "aiSupplement": {
              "explanation": [
                {
                  "text": "A gene can be isolated from existing donor DNA or built chemically from nucleotides once its required sequence is known. Both routes produce DNA without first copying an mRNA molecule.",
                  "refs": [
                    "ms:b.ii#1",
                    "ms:b.ii#2"
                  ]
                }
              ],
              "reasoningChain": [
                "Name the existing-DNA route.",
                "Name the chemical-synthesis route."
              ],
              "inferredMistakes": []
            }
          }
