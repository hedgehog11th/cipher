            "source": {
              "qp": 16,
              "ms": 15
            },
            "stem": [
              {
                "type": "text",
                "text": "Outline <b>two</b> sources, other than messenger RNA, from which genes can be obtained for genetic engineering.",
                "source": {
                  "qp": 16
                }
              }
            ],
            "topics": [
              {
                "ref": "19.1(3)",
                "role": "primary"
              }
            ],
            "markScheme": {
              "marks": 2,
              "instruction": null,
              "guidance": [],
              "points": [
                {
                  "n": 1,
                  "text": "genes cut from (donor) <u>DNA</u> <b>;</b>"
                },
                {
                  "n": 2,
                  "text": "genes synthesised (chemically) from <u>nucleotides</u> <b>; </b>"
                }
