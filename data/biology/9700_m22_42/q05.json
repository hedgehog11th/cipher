            "stem": [
              {
                "type": "text",
                "text": "Name the disease that is treated using recombinant human factor VIII.",
                "source": {
                  "qp": 16
                }
              }
            ],
            "topics": [
              {
                "ref": "19.2(1)",
                "role": "primary"
