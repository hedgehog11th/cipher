              "er.q5.a.i"
            ],
            "aiSupplement": {
              "explanation": [
                {
                  "text": "Factor VIII participates in blood clotting. Link the named replacement protein to the condition in which its functional activity is deficient.",
                  "refs": [
                    "ms:a.i#1"
                  ]
                }
              ],
              "reasoningChain": [
                "Recall the role of factor VIII.",
                "Name the corresponding clotting disorder."
              ],
              "inferredMistakes": []
            }
          },
          {
            "key": "a.ii",
            "label": "(ii)",
            "type": "short",
            "marks": 2,
            "source": {
              "qp": 16,
              "ms": 15
            },
            "stem": [
              {
                "type": "text",
                "text": "Before recombinant human factor VIII was available, this disease was treated with factor VIII from donated blood.",
                "source": {
                  "qp": 16
                }
              },
              {
                "type": "text",
                "text": "Give <b>two</b> advantages of using recombinant human factor VIII, instead of factor VIII from donated blood, to treat this disease.",
                "source": {
                  "qp": 16
                }
              }
            ],
            "topics": [
              {
                "ref": "19.2(1)",
                "role": "primary"
              }
            ],
            "markScheme": {
              "marks": 2,
              "instruction": "<i>any </i><b><i>two</i></b><i> from:</i><br><i>accept ora throughout </i>",
              "guidance": [],
              "points": [
                {
                  "n": 1,
                  "text": "large / unlimited, supply <b>; </b>"
                },
                {
                  "n": 2,
                  "text": "no risk of infection <b>;</b>"
                },
                {
                  "n": 3,
                  "text": "no / fewer, ethical issues <b>;</b>"
                },
                {
                  "n": 4,
                  "text": "less chance of, rejection / immune response / allergic response / side effects <b>;</b>"
                },
                {
                  "n": 5,
                  "text": "cheap / quick, to produce <b>;</b>"
                },
                {
                  "n": 6,
                  "text": "no need to wait for donor <b>; </b>"
                }
              ],
              "source": {
                "ms": 15
              }
            },
            "er": [
              "er.q5.a.ii"
            ],
            "aiSupplement": {
              "explanation": [
                {
                  "text": "Frame each advantage as a comparison with dependence on donated blood. Recombinant production can provide a controlled supply without the same donor-associated infection or availability constraints.",
                  "refs": [
                    "ms:a.ii#1",
                    "ms:a.ii#2",
                    "ms:a.ii#3",
                    "ms:a.ii#4",
                    "ms:a.ii#5",
                    "ms:a.ii#6"
                  ]
                }
              ],
              "reasoningChain": [
                "Identify a limitation of donated blood.",
                "Explain how recombinant production avoids it.",
                "Give a second distinct advantage."
              ],
              "inferredMistakes": []
            }
          }
        ]
      },
      {
