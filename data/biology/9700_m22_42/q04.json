            },
            "stem": [
              {
                "type": "text",
                "text": "Suggest <b>two</b> reasons why phenotypic ratios in the F2 generation do <b>not</b> always match the expected ratios.",
                "source": {
                  "qp": 15
                }
              }
            ],
            "topics": [
