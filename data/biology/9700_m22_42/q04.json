            },
            "stem": [
              {
                "type": "text",
                "text": "The critical value at the 0.05 probability level and three degrees of freedom is 7.81.",
                "source": {
                  "qp": 15
                }
              },
              {
                "type": "text",
                "text": "Using the result of your calculation in <b>(b)(ii)</b>, explain whether the results of the study agree with the expected ratio of phenotypes for the F2 generation.",
                "source": {
                  "qp": 15
                }
              }
            ],
            "topics": [
