        "stem": [
          {
            "type": "text",
            "text": "Meiosis is an important process that contributes to genetic variation in a population.",
            "source": {
              "qp": 12
            }
          },
          {
            "type": "text",
            "text": "Fig. 4.1 shows a pair of homologous chromosomes during prophase I of meiosis.",
            "source": {
              "qp": 12
            }
          },
          {
            "type": "figure",
            "id": "fig4.1",
            "caption": "Fig. 4.1",
            "src": "figures/q4_fig4_1.png",
            "alt": "Two homologous chromosomes during prophase I, with white and grey non-sister chromatids crossing.",
            "source": {
              "qp": 12
            }
          }
        ],
        "parts": [
          {
            "key": "a.i",
            "label": "(i)",
            "type": "drawing",
            "marks": 1,
            "source": {
              "qp": 12,
              "ms": 12
            },
            "stem": [
              {
                "type": "text",
                "text": "On Fig. 4.1, use the letter <b>C</b> with a label line to identify where crossing over occurs.",
                "source": {
                  "qp": 12
                }
              }
            ],
            "topics": [
              {
                "ref": "16.1(6)",
                "role": "primary"
              }
            ],
            "markScheme": {
              "marks": 1,
              "instruction": null,
