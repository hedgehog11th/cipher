              "inferredMistakes": []
            }
          },
          {
            "key": "a.ii",
            "label": "(ii)",
            "type": "extended",
            "marks": 4,
            "source": {
              "qp": 12,
              "ms": 12
            },
            "stem": [
              {
                "type": "text",
                "text": "Describe how crossing over produces genetic variation in a population.",
                "source": {
                  "qp": 12
                }
              }
            ],
            "topics": [
              {
                "ref": "16.1(6)",
                "role": "primary"
              },
              {
                "ref": "16.1(7)",
                "role": "secondary"
              }
            ],
            "markScheme": {
              "marks": 4,
              "instruction": "<i>any </i><b><i>four</i></b><i> from: </i>",
              "guidance": [],
              "points": [
                {
                  "n": 1,
                  "text": "(crossing over is) between non-sister chromatids <b>;</b>"
                },
                {
                  "n": 2,
                  "text": "(non-sister chromatids have) different combinations of alleles <b>;</b>"
                },
                {
                  "n": 3,
                  "text": "exchange alleles <b>;</b>"
                },
                {
                  "n": 4,
                  "text": "(chromatids have) new combinations of alleles <b>;</b>"
                },
                {
                  "n": 5,
                  "text": "linkage groups broken <b>; </b>"
                },
                {
                  "n": 6,
                  "text": "<i>idea that</i> gametes have unique combination of alleles <b>;</b>"
                },
                {
                  "n": 7,
                  "text": "random fusion of gametes (during fertilisation) <b>; </b>"
                }
              ],
              "source": {
                "ms": 12
              }
            },
            "er": [
              "er.q4.a.ii"
            ],
            "aiSupplement": {
              "explanation": [
                {
                  "text": "Crossing over changes combinations of alleles along chromatids. The chromatids subsequently segregate into gametes, and fertilisation combines these genetically different gametes into the next generation.",
                  "refs": [
                    "ms:a.ii#1",
                    "ms:a.ii#2",
                    "ms:a.ii#3",
                    "ms:a.ii#4",
                    "ms:a.ii#6",
                    "ms:a.ii#7"
                  ]
                }
              ],
              "reasoningChain": [
                "Specify non-sister chromatids.",
                "Trace exchange to new allele combinations.",
                "Connect changed gametes to offspring variation."
              ],
              "inferredMistakes": []
            }
          }
        ]
      },
      {
        "key": "b",
        "label": "(b)",
