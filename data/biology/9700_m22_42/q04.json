            ],
            "aiSupplement": {
              "explanation": [
                {
                  "text": "F1 identifies the first filial generation produced by the parental cross. In this experiment the contrasting homozygous parents produce offspring heterozygous at the two loci.",
                  "refs": [
                    "ms:b.i#1",
                    "ms:b.i#2",
                    "ms:b.i#3"
