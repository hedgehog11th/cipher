                }
              ],
              "source": {
                "ms": 12
              }
            },
            "er": [
              "er.q4.a.i"
            ],
            "aiSupplement": {
              "explanation": [
                {
                  "text": "Identify the physical crossover between one chromatid of each homologue. A centromere joins sister chromatids within a chromosome and is not the exchange site.",
                  "refs": [
                    "ms:a.i#1"
                  ]
                }
              ],
              "reasoningChain": [
                "Distinguish the two homologues.",
                "Draw the label line to the point where non-sister chromatids cross."
