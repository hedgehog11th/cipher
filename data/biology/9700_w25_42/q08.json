          "instruction": null,
          "guidance": [],
          "points": [
            {
              "n": 1,
              "text": "1  ecosystem / habitat (diversity)<b> ;</b>",
              "numberedInMs": false
            },
            {
              "n": 2,
              "text": "2  species (diversity / richness) <b>;</b>",
              "numberedInMs": false
