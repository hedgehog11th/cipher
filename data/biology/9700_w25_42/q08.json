          "guidance": [],
          "points": [
            {
              "n": 1,
              "text": "1  (named) protected reserves <b>; </b>",
              "numberedInMs": false
            },
            {
              "n": 2,
              "text": "2  <b>limit</b> palm oil plantations / <i>ref. to</i> sustainable palm oil production <b>;</b>",
              "numberedInMs": false
            },
            {
              "n": 3,
              "text": "3  restoring lost habitat / reforestation / reduce deforestation <b>; </b>",
              "numberedInMs": false
