        "stem": [
          {
            "type": "text",
            "text": "Action potentials are produced by the Venus fly trap during the closure of a leaf. Each action potential is also associated with a refractory period. This is similar to the action potential and refractory period observed in a mammalian neurone during nerve impulse transmission.",
            "source": {
              "qp": 19
            }
          },
          {
            "type": "text",
            "text": "Explain the role played by the refractory period in the transmission of an impulse in a mammalian neurone.",
            "source": {
              "qp": 19
            }
          }
        ],
        "marks": 3,
        "topics": [
          {
            "ref": "15.1(8)",
            "role": "primary"
          }
        ],
        "markScheme": {
          "marks": 3,
          "instruction": "<i>any</i><b><i> three </i></b><i>from :</i><b><i> </i></b> <i> </i>",
          "guidance": [],
          "points": [
            {
              "n": 1,
              "text": "1  impulses / action potentials, are discrete events / AW <b>;</b>",
              "numberedInMs": false
            },
            {
              "n": 2,
              "text": "2  impulses / action potentials, are unidirectional <b>;</b>",
              "numberedInMs": false
            },
            {
              "n": 3,
              "text": "3  determines / limits, the frequency of, impulses / action potentials <b>;</b>",
              "numberedInMs": false
            },
            {
              "n": 4,
              "text": "4  AVP <b>;</b> e.g. 200-300 action potentials per second<b>  </b>",
              "numberedInMs": false
            }
          ]
        },
        "er": [],
        "aiSupplement": {
          "explanation": [
            {
              "text": "During the refractory period, recently active membrane cannot immediately generate another normal action potential. This limits impulse frequency and favours forward propagation.",
              "refs": [
                "syllabus:15.1(8)",
                "ms:b#1"
              ]
            }
          ],
