              "qp": 18
            }
          },
          {
            "type": "text",
            "text": "Fig. 7.1 shows how the leaf of a Venus fly trap appears folded (closed) when an insect has been captured.",
            "source": {
              "qp": 18
            }
          },
          {
            "type": "figure",
            "id": "fig7.1",
            "caption": "Fig. 7.1",
            "src": "figures/q7_fig7_1.png",
            "alt": "Closed Venus fly trap",
            "source": {
              "qp": 18
            }
          }
        ],
