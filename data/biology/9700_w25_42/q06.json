        "stem": [
          {
            "type": "text",
            "text": "Describe how a biosensor can be used to measure blood glucose concentration.",
            "source": {
              "qp": 17
            }
          }
        ],
        "marks": 7,
        "topics": [
          {
            "ref": "14.1(11)",
            "role": "primary"
          }
        ],
        "markScheme": {
          "marks": 7,
          "instruction": "<i>any</i><b><i> seven </i></b><i>from :</i><b><i> </i></b>",
          "guidance": [],
          "points": [
            {
              "n": 1,
              "text": "1  (biosensor has) glucose oxidase (immobilised on recognition layer) <b>;</b>",
              "numberedInMs": false
            },
            {
              "n": 2,
              "text": "2  blood sample added <b>;</b>",
              "numberedInMs": false
            },
            {
              "n": 3,
              "text": "3  glucose (in blood) passes through, partially / selectively, permeable membrane <b>; </b>",
              "numberedInMs": false
            },
            {
              "n": 4,
              "text": "4  glucose oxidase, oxidises glucose / converts glucose / catalyses glucose reaction <b>;</b>",
              "numberedInMs": false
            },
            {
              "n": 5,
              "text": "5  gluconic acid and hydrogen peroxide formed <b>;</b>",
              "numberedInMs": false
            },
            {
              "n": 6,
              "text": "6  reaction converted to a current (by transducer) <b>;</b>",
              "numberedInMs": false
            },
            {
              "n": 7,
              "text": "7  current is amplified <b>;</b>",
              "numberedInMs": false
            },
            {
              "n": 8,
              "text": "8  digital / numerical / quantitative, reading <b>;</b>",
              "numberedInMs": false
            },
            {
              "n": 9,
              "text": "9  size of current is proportional to glucose concentration <b>;</b>",
              "numberedInMs": false
            },
            {
              "n": 10,
              "text": "10 instant result / accurate <b>;</b>",
              "numberedInMs": false
            }
          ]
        },
        "er": [],
        "aiSupplement": {
          "explanation": [
            {
              "text": "A biosensor converts a glucose-dependent chemical reaction into a measurable signal. The signal must be related to concentration using calibration rather than merely detecting glucose presence.",
