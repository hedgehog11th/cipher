        },
        "stem": [
          {
            "type": "text",
            "text": "Muscle contraction can be affected by a low blood glucose concentration.",
            "source": {
              "qp": 27
            }
          },
          {
            "type": "text",
            "text": "Suggest how a low blood glucose concentration would affect the functioning of the sarcomere.",
            "source": {
              "qp": 27
            }
          }
        ],
        "marks": 3,
        "topics": [
          {
            "ref": "15.1(12)",
            "role": "primary"
          }
        ],
        "markScheme": {
          "marks": 3,
          "instruction": "<i>any</i><b><i> three </i></b><i>from :</i><b><i> </i></b> <b> </b>",
          "guidance": [],
          "points": [
            {
              "n": 1,
              "text": "1  (decreased rate of respiration so), no / less, ATP produced <b>;</b>",
              "numberedInMs": false
            },
            {
              "n": 2,
              "text": "2  no / less, Ca<sup>2+</sup> pumped back into sarcoplasmic reticulum <b>;</b>",
              "numberedInMs": false
            },
            {
              "n": 3,
              "text": "3  no / less, release of myosin heads from actin / cross bridges broken <b>or</b> no / less, hydrolysis of ATP by myosin head / return of myosin head to original position <b>;</b> AW",
              "numberedInMs": false
            },
            {
              "n": 4,
              "text": "4  sarcomere, permanently contracted / cannot relax <b>;</b>  <b>A</b> paralysis",
              "numberedInMs": false
            },
            {
              "n": 5,
              "text": "5  slower sarcomere contraction / less sarcomere shortening / weaker power stroke <b>; </b>",
              "numberedInMs": false
            }
          ]
        },
        "er": [],
        "aiSupplement": {
          "explanation": [
            {
              "text": "Calcium exposes myosin-binding sites through the troponin–tropomyosin system. ATP permits detachment and supplies energy for further cross-bridge cycling; filament length remains constant.",
              "refs": [
                "syllabus:15.1(12)",
                "ms:c#1"
              ]
            }
          ],
          "reasoningChain": [
            "Trace calcium binding to exposure of actin sites.",
            "Follow attachment, movement, detachment and reactivation of myosin."
          ],
          "inferredMistakes": [
            {
              "text": "Saying that actin and myosin filaments shorten during contraction",
              "basis": "inferred",
              "refs": [
                "syllabus:15.1(12)"
              ]
            }
