        "stem": [
          {
            "type": "text",
            "text": "Scientists investigated the effect of temperature on the rate of photosynthesis <b>and</b> the rate of respiration of the trailing azalea, <i>Kalmia</i> <i>procumbens</i>, at a high light intensity.",
            "source": {
              "qp": 24
            }
          },
          {
            "type": "text",
            "text": "Fig. 9.2 shows the results of this investigation.",
            "source": {
              "qp": 24
            }
          },
          {
            "type": "figure",
            "id": "fig9.2",
            "caption": "Fig. 9.2",
            "src": "figures/q9_fig9_2.png",
            "alt": "Temperature and rates of photosynthesis and respiration",
            "source": {
              "qp": 24
            }
          }
        ],
