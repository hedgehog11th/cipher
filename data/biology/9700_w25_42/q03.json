            },
            "stem": [
              {
                "type": "text",
                "text": "The glucose 6‑phosphate in the cytoplasm of the bacterial cell is used to produce fructose 1,6‑bisphosphate.",
                "source": {
                  "qp": 7
                }
              },
              {
                "type": "text",
                "text": "Fructose 1,6‑bisphosphate is used in glycolysis.",
                "source": {
                  "qp": 7
                }
              },
              {
                "type": "text",
                "text": "Outline  the  events  that  occur  in  glycolysis  following  the  production  of fructose 1,6‑bisphosphate.",
                "source": {
                  "qp": 7
                }
              }
            ],
            "marks": 3,
