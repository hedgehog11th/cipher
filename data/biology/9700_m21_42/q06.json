    "stem": [
      {
        "type": "text",
        "text": "Dogs have an exceptionally good sense of smell. They can detect molecules in the air with a concentration of one part per trillion (10<sup>12</sup>).",
        "source": {
          "qp": 14
        }
      }
    ],
    "parts": [
      {
        "key": "a",
        "label": "(a)",
        "type": "extended",
        "marks": 5,
        "source": {
          "qp": 14,
          "ms": 14
        },
        "stem": [
          {
            "type": "text",
            "text": "Olfactory receptor cells are the sensory receptors in the nasal cavity that respond to chemicals in the air. They function in a similar way to the chemoreceptor cells in the taste buds of the tongue.",
            "source": {
              "qp": 14
            }
          },
          {
            "type": "text",
            "text": "Describe how olfactory receptor cells in the nasal cavity of dogs respond to chemicals to generate an action potential.",
            "source": {
              "qp": 14
            }
          }
        ],
        "topics": [
          {
            "ref": "15.1(5)",
            "role": "primary"
          }
        ],
        "markScheme": {
          "marks": 5,
          "instruction": "<i>any </i><b><i>five</i></b><i> from: </i>",
          "guidance": [],
          "points": [
            {
              "n": 1,
              "text": "chemicals, stimulate / bind to / enter, (receptor cells) <b>;</b>"
            },
            {
              "n": 2,
              "text": "Na<sup>+</sup> enters (receptor cells) via microvilli <b>;</b>"
            },
            {
              "n": 3,
              "text": "<u>membrane</u> depolarised <b>;</b>"
            },
            {
              "n": 4,
              "text": "ref. to receptor potential <b>;</b>"
            },
            {
              "n": 5,
              "text": "ref. to threshold <b>;</b>"
            },
            {
              "n": 6,
              "text": "voltage-gated Ca<sup>2+</sup> channels open / Ca<sup>2+</sup> ions enter, cytoplasm / cell <b>;</b>"
            },
            {
              "n": 7,
              "text": "vesicles (of neurotransmitter), move towards / fuse with, (cell surface) membrane <b>;</b>"
            },
            {
              "n": 8,
              "text": "exocytosis of neurotransmitter / AW <b>;</b>"
            },
            {
              "n": 9,
              "text": "neurotransmitter binds to receptor <b>;</b>"
            },
            {
              "n": 10,
              "text": "(receptor cell) acts as a transducer <b>;</b>"
            }
          ],
