        "aiSupplement": {
          "explanation": [
            {
              "text": "The question supplies an analogy with taste receptors. A receptor potential in the receptor cell leads to calcium entry and transmitter release, which can stimulate the connected sensory neurone; separate this from propagation along an axon.",
              "refs": [
                "ms:a#1",
                "ms:a#2",
                "ms:a#3",
                "ms:a#4",
                "ms:a#5",
                "ms:a#6",
                "ms:a#7",
                "ms:a#8",
                "ms:a#9",
                "ms:a#10"
              ]
            }
          ],
          "reasoningChain": [
            "Identify chemical detection and depolarisation.",
            "Relate a sufficient receptor potential to calcium entry.",
            "Trace secretion and transmitter binding."
          ],
