        }
      },
      {
        "key": "b",
        "label": "(b)",
        "type": "short",
        "marks": 2,
        "source": {
          "qp": 14,
          "ms": 14
        },
        "stem": [
          {
            "type": "text",
            "text": "Dogs can use their sense of smell to detect differences between the breath of people with lung cancer and the breath of people without lung cancer. These differences are due to the presence of particular chemicals at very low concentrations in the breath of people with lung cancer. Dogs can be trained to sit when a person’s breath indicates that lung cancer is present.",
            "source": {
              "qp": 14
            }
          },
          {
            "type": "text",
            "text": "Screening people for lung cancer is important for early detection and treatment.",
            "source": {
              "qp": 14
            }
          },
          {
            "type": "text",
            "text": "Suggest <b>two</b> advantages of using <b>dogs</b> in this way to screen people for lung cancer.",
            "source": {
              "qp": 14
            }
          }
        ],
        "topics": [
          {
            "ref": "15.1(4)",
            "role": "primary"
          }
        ],
        "markScheme": {
          "marks": 2,
          "instruction": "<i>any </i><b><i>two</i></b><i> from: </i>",
          "guidance": [],
          "points": [
            {
              "n": 1,
              "text": "non-invasive / safe <b>;</b>"
            },
            {
              "n": 2,
              "text": "quick / immediate results / saves time / early detection <b>;</b>"
            },
            {
              "n": 3,
              "text": "can be done at home / no equipment <b>;</b>"
            },
            {
              "n": 4,
              "text": "cheap / cost effective <b>;</b>"
            }
          ],
          "source": {
            "ms": 14
          }
        },
        "er": [
          "er.q6.b"
        ],
        "aiSupplement": {
          "explanation": [
            {
              "text": "Evaluate the procedure as a method of detecting a chemical stimulus. Practical benefits can include lack of invasive sampling and rapid results. This clinical-screening context is an application of sensory detection; it is not genetic screening under 19.2(2).",
