        "markScheme": {
          "marks": 9,
          "instruction": "<i>any </i><b><i>nine</i></b><i> from: </i>",
          "guidance": [],
          "points": [
            {
              "n": 1,
              "text": "probes are, single-stranded DNA / ssDNA <b>; </b>"
            },
            {
              "n": 2,
              "text": "each probe is unique to a particular gene <b>; </b>"
            },
            {
              "n": 3,
              "text": "probes correspond to thousands of different genes <b>;</b>"
            },
            {
              "n": 4,
              "text": "extract mRNA <b>;</b>"
