            "stem": [
              {
                "type": "text",
                "text": "In regions of south-west Europe where grey wolf populations are present, farmers are concerned for the safety of their livestock, such as sheep.",
                "source": {
                  "qp": 7
                }
              },
              {
                "type": "text",
                "text": "Suggest how governments can help farmers who are concerned for the safety of their livestock.",
                "source": {
                  "qp": 7
                }
              }
            ],
            "topics": [
              {
                "ref": "18.3(2)",
