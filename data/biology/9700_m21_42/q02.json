                {
                  "n": 2,
                  "text": "education / (public) awareness programmes <b>; </b>"
                },
                {
                  "n": 3,
                  "text": "research qualified <b>;</b><br>e.g. habitat, diet, reproduction"
                },
                {
                  "n": 4,
                  "text": "ban, hunting / trade (of wolf products) <b>;</b>"
                },
                {
                  "n": 5,
                  "text": "monitor populations <b>; </b>"
