              "qp": 4,
              "ms": 7
            },
            "stem": [
              {
                "type": "text",
                "text": "Suggest <b>and </b>explain the effects on the biodiversity of south-west Europe if the grey wolf becomes extinct.",
                "source": {
                  "qp": 4
                }
              }
            ],
            "topics": [
              {
                "ref": "18.2(2)",
                "role": "primary"
              }
            ],
            "markScheme": {
              "marks": 3,
              "instruction": "<i>any </i><b><i>three</i></b><i> from: </i>",
              "guidance": [],
              "points": [
                {
                  "n": 1,
                  "text": "decrease in biodiversity <b>; </b>"
                },
                {
                  "n": 2,
                  "text": "prey of grey wolf / herbivores, (may) increase in number <b>; </b>"
                },
                {
                  "n": 3,
                  "text": "(leads to) overgrazing <b>;</b><br><b>A </b>herbivores would decrease plant populations"
                },
                {
                  "n": 4,
                  "text": "change in, ecosystem / habitat / food web <b>; </b>"
                },
                {
                  "n": 5,
                  "text": "change in genetic variation <b>;</b>"
                },
                {
                  "n": 6,
                  "text": "over many years <b>;</b>"
