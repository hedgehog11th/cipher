              "guidance": [],
              "points": [
                {
                  "n": 1,
                  "text": "compensation scheme (for loss of livestock) <b>; </b>"
                },
                {
                  "n": 2,
                  "text": "<i>idea of</i> protection of livestock <b>;</b><br>e.g. build, fences / enclosures"
