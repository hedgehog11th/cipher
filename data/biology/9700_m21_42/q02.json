        "stem": [
          {
            "type": "text",
            "text": "The grey wolf, <i>Canis lupus</i>, is a large predator. During the 20th century, the grey wolf in south-west Europe was hunted almost to extinction.",
            "source": {
              "qp": 4
            }
          },
          {
            "type": "text",
            "text": "Fig. 2.1 shows a grey wolf.",
            "source": {
              "qp": 4
            }
          },
          {
            "type": "figure",
            "id": "fig2.1",
            "caption": "Fig. 2.1",
            "src": "figures/q2_fig2_1.png",
            "alt": "Photograph of a grey wolf standing in grass.",
            "source": {
              "qp": 4
            }
          }
        ],
        "parts": [
