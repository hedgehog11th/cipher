            "er": [
              "er.q2.a.ii"
            ],
            "aiSupplement": {
              "explanation": [
                {
                  "text": "Distinguish the immediate loss of one species from indirect changes through the food web. A predator’s removal can change herbivore abundance and vegetation, so biodiversity effects can extend beyond the predator itself.",
                  "refs": [
                    "ms:a.ii#1",
                    "ms:a.ii#2",
                    "ms:a.ii#3",
                    "ms:a.ii#4",
                    "ms:a.ii#5",
                    "ms:a.ii#6"
                  ]
                }
              ],
              "reasoningChain": [
                "Consider the direct species and genetic loss.",
                "Trace changes from prey abundance to grazing.",
                "Connect indirect effects with the wider community."
              ],
              "inferredMistakes": []
            }
          }
        ]
      },
      {
        "key": "b",
