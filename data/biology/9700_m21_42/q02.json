        },
        "stem": [
          {
            "type": "text",
            "text": "Grey wolves can have territories of up to 950 km<sup>2</sup>. Grey wolves can travel up to 1000 km to start a new population.",
            "source": {
              "qp": 5
            }
          },
          {
            "type": "text",
            "text": "State reasons why the mark-release-recapture method is <b>not</b> suitable for estimating the size of a grey wolf population.",
            "source": {
              "qp": 5
            }
          }
        ],
        "topics": [
          {
            "ref": "18.2(4)",
            "role": "primary"
          }
        ],
        "markScheme": {
          "marks": 2,
          "instruction": "<i>any </i><b><i>two</i></b><i> from: </i>",
          "guidance": [],
          "points": [
            {
              "n": 1,
              "text": "difficult to capture <b>; </b>"
            },
            {
              "n": 2,
              "text": "dangerous (to humans) <b>; </b>"
            },
            {
              "n": 3,
              "text": "large territory (so unlikely to recapture) <b>; </b>"
            },
            {
              "n": 4,
              "text": "migration <b>; </b>"
            },
            {
              "n": 5,
              "text": "may not mix with other wolves <b>;</b>"
            },
            {
              "n": 6,
              "text": "small, sample size / populations (so inaccurate) <b>;</b>"
            }
          ],
          "source": {
            "ms": 8
          }
        },
        "er": [
          "er.q2.b"
        ],
        "aiSupplement": {
          "explanation": [
            {
              "text": "Population estimates from recaptures depend on a sufficiently closed, mixing population and practical repeated capture. Large ranges and migration undermine those assumptions and make representative sampling difficult.",
              "refs": [
                "ms:b#1",
                "ms:b#2",
                "ms:b#3",
                "ms:b#4",
                "ms:b#5",
                "ms:b#6"
              ]
            }
          ],
          "reasoningChain": [
            "Identify assumptions affected by wolf movement.",
            "State practical capture or safety limitations."
          ],
          "inferredMistakes": []
        }
      },
