        "stem": [
          {
            "type": "text",
            "text": "Crossing over results in genetic variation.",
            "source": {
              "qp": 17
            }
          },
          {
            "type": "text",
            "text": "Explain how random assortment of homologous chromosomes also results in genetic variation.",
            "source": {
              "qp": 17
            }
          }
        ],
