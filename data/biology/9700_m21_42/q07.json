        "aiSupplement": {
          "explanation": [
            {
              "text": "Independent assortment concerns the orientation of different homologous pairs, rather than exchange within a pair. Their independent orientations lead to different combinations of maternal and paternal chromosomes entering daughter cells.",
              "refs": [
                "ms:c#1",
                "ms:c#2",
                "ms:c#3",
                "ms:c#4",
                "ms:c#5"
              ]
