          "guidance": [],
          "points": [
            {
              "n": 1,
              "text": "homologous chromosomes / bivalents, align independently of each other <b>; </b>"
            },
            {
              "n": 2,
              "text": "at the, equator / metaphase plate <b>;</b>"
            },
            {
              "n": 3,
              "text": "<i>idea that </i>this leads to different combinations of chromosomes in the daughter cells <b>;</b>"
            },
            {
              "n": 4,
              "text": "results in new combinations of alleles <b>;</b>"
