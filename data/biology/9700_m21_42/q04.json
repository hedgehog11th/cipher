    "stem": [
      {
        "type": "text",
        "text": "Red algae are multicellular photosynthetic protoctists that contain phycoerythrin. Phycoerythrin is a photosynthetic pigment.",
        "source": {
          "qp": 10
        }
      }
    ],
    "parts": [
      {
