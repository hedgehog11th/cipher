              "points": [
                {
                  "n": 1,
                  "text": "not enough, nitrogen / nitrate, in the soil<br><b>or </b><br> poor mineral content of the soil <b>;</b>",
                  "numberedInMs": false
                },
                {
                  "n": 2,
                  "text": "<b>R </b>nutrients",
