        "stem": [
          {
            "type": "text",
            "text": "The Venus fly trap is a plant that is able to capture and digest insects. It has modified leaves, which have sensory hairs that respond to touch. When an insect comes into contact with the hairs, receptor potentials are generated.",
            "source": {
              "qp": 13
            }
          }
        ],
        "parts": [
          {
            "key": "b.i",
            "label": "(i)",
            "type": "short",
            "marks": 1,
            "source": {
              "qp": 13,
              "ms": 13
            },
            "stem": [
              {
                "type": "text",
                "text": "Name the ion that moves into the cells at the base of the sensory hairs to generate receptor potentials.",
                "source": {
                  "qp": 13
                }
              }
            ],
            "topics": [
              {
                "ref": "15.2(1)",
                "role": "primary"
              }
            ],
            "markScheme": {
              "marks": 1,
              "instruction": null,
              "guidance": [],
              "points": [
                {
                  "n": 1,
                  "text": "Ca<sup>2+</sup>/ calcium ions <b>;</b>",
                  "numberedInMs": false
                }
              ],
              "source": {
                "ms": 13
              }
            },
            "er": [
              "er.q5.b.i"
            ],
            "aiSupplement": {
              "explanation": [
                {
                  "text": "Use the ion involved in this plant sensory response rather than automatically transferring the sodium-ion mechanism from an animal neurone.",
                  "refs": [
                    "ms:b.i#1"
                  ]
                }
              ],
              "reasoningChain": [
                "Identify the ion responsible for the receptor potential in the sensory hair."
              ],
              "inferredMistakes": []
            }
          },
          {
            "key": "b.ii",
            "label": "(ii)",
            "type": "short",
            "marks": 1,
            "source": {
              "qp": 13,
              "ms": 13
            },
            "stem": [
              {
                "type": "text",
                "text": "If two or more of these hairs are stimulated within a period of 20–35 seconds, action potentials are generated, causing the leaf to close quickly and trap the insect.",
                "source": {
                  "qp": 13
                }
              },
              {
                "type": "text",
                "text": "Suggest why it is beneficial to the plant for stimulation of two or more hairs to be necessary before the leaf will close.",
                "source": {
                  "qp": 13
                }
              }
            ],
            "topics": [
              {
                "ref": "15.2(1)",
                "role": "primary"
              }
            ],
            "markScheme": {
              "marks": 1,
              "instruction": null,
              "guidance": [],
              "points": [
                {
                  "n": 1,
                  "text": "to avoid wasting <u>energy</u><br><b>or </b><br> <i>idea of </i>avoid closing, due to a single contact / by an object such as water drop <b>;</b>",
                  "numberedInMs": false
                }
              ],
              "source": {
                "ms": 13
              }
            },
            "er": [
              "er.q5.b.ii"
            ],
            "aiSupplement": {
              "explanation": [
                {
                  "text": "Requiring more than one contact helps distinguish a moving prey animal from an isolated accidental stimulus. This reduces unnecessary closure and its energy cost.",
                  "refs": [
                    "ms:b.ii#1"
                  ]
                }
              ],
              "reasoningChain": [
                "Compare repeated movement with a single incidental contact.",
                "Relate discrimination to energy conservation."
              ],
              "inferredMistakes": []
            }
          },
          {
            "key": "b.iii",
            "label": "(iii)",
            "type": "short",
            "marks": 1,
            "source": {
              "qp": 13,
              "ms": 13
