        "stem": [
          {
            "type": "text",
            "text": "Researchers compared the effect of two types of meal on the mean blood glucose concentration and the mean blood insulin concentration of twelve volunteers. The measurements were made for three hours after the meal.",
            "source": {
              "qp": 18
            }
          },
          {
            "type": "text",
            "text": "Meal A contained 55% carbohydrate, 27% fat and 18% protein. Meal B contained 3% carbohydrate, 90% fat and 7% protein.",
            "source": {
              "qp": 18
            }
          },
          {
            "type": "text",
            "text": "Fig. 7.1 shows the results.",
            "source": {
              "qp": 18
            }
          },
          {
            "type": "figure",
            "id": "fig7.1",
            "caption": "Fig. 7.1",
            "src": "figures/q7_fig7_1.png",
            "alt": "Blood glucose concentration after two meals",
            "source": {
              "qp": 18
            }
          }
        ],
        "parts": [
          {
            "key": "b.i",
            "label": "(i)",
            "source": {
              "qp": 19,
              "ms": 14
            },
            "stem": [
              {
                "type": "text",
                "text": "With reference to Fig. 7.1, explain how negative feedback operates to control mean blood glucose concentration in the volunteers who ate meal A.",
                "source": {
                  "qp": 19
                }
              }
            ],
            "marks": 4,
            "topics": [
              {
                "ref": "14.1(10)",
                "role": "primary"
              }
            ],
            "markScheme": {
              "marks": 4,
              "instruction": "<i>any </i><b><i>four</i></b><i> from: </i>",
              "guidance": [],
              "points": [
                {
                  "n": 1,
                  "text": "<b>1 </b> at 21 min, blood glucose concentration / it, rises to 110 mg 100 cm<sup>–3</sup>  <b>; </b>",
                  "numberedInMs": false
                },
                {
                  "n": 2,
                  "text": "<b>2 </b> (high / increase in, blood glucose concentration) detected by pancreas / causes response in pancreas <b>;</b>",
                  "numberedInMs": false
                },
                {
                  "n": 3,
                  "text": "<b>3 </b> insulin rises to 500 pmol dm<sup>-3</sup> <b>; </b>",
                  "numberedInMs": false
                },
                {
                  "n": 4,
                  "text": "<b>4 </b> (insulin) increase GLUT proteins in membrane / increases glucose uptake into cells / increases cell permeability to glucose <b>or </b> (insulin) increases rate of respiration of glucose<b> ; </b>",
                  "numberedInMs": false
                },
                {
                  "n": 5,
                  "text": "<b>5 </b> (insulin) causes / stimulates, glycogenesis / lipogenesis <b>; </b>",
                  "numberedInMs": false
                },
                {
                  "n": 6,
                  "text": "<b>6 </b> (mean)<b> </b>blood glucose concentration / it, falls, to normal / within normal range / below starting point / to set point <b>;</b>",
                  "numberedInMs": false
                }
              ]
            },
            "er": [],
            "aiSupplement": {
              "explanation": [
                {
                  "text": "Negative feedback changes glucose uptake, release or storage in a direction that reduces the initial deviation. A graph after a meal reflects the combined effects of absorption and regulation.",
                  "refs": [
                    "syllabus:14.1(10)",
                    "ms:b.i#1"
                  ]
                }
              ],
              "reasoningChain": [
                "Identify whether glucose is above or below the normal range.",
                "Trace the hormone response and its effects on target cells."
              ],
              "inferredMistakes": [
                {
                  "text": "Reversing the effects of insulin and glucagon",
                  "basis": "inferred",
                  "refs": [
                    "syllabus:14.1(10)"
                  ]
                }
              ]
            },
            "type": "short"
          },
