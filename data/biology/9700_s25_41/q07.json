        "aiSupplement": {
          "explanation": [
            {
              "text": "Endocrine signals travel in the blood, but only cells with suitable receptors respond. Hormone source, transport and target-cell recognition are separate features.",
              "refs": [
                "syllabus:15.1(1)",
                "ms:a#1"
