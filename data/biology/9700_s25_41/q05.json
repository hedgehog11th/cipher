        },
        "stem": [
          {
            "type": "text",
            "text": "Scientists studied the effect of an increase in the number of tourists each year on the number of invasive alien species present in the Galápagos islands.",
            "source": {
              "qp": 14
            }
          },
          {
            "type": "text",
            "text": "The scientists recorded the number of invasive alien species present each year in the Galápagos islands over many years. The scientists also recorded the number of tourists visiting the islands each year.",
            "source": {
              "qp": 14
            }
          },
          {
            "type": "text",
            "text": "Fig. 5.4 shows a graph of the data for five different years during the study.",
            "source": {
              "qp": 14
            }
          },
          {
            "type": "figure",
            "id": "fig5.4",
            "caption": "Fig. 5.4",
            "src": "figures/q5_fig5_4.png",
            "alt": "Tourism and invasive species",
            "source": {
              "qp": 14
            }
          }
        ],
        "parts": [
          {
            "key": "c.i",
