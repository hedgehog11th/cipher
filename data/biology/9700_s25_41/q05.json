              "guidance": [],
              "points": [
                {
                  "n": 1,
                  "text": "<u>directional</u> (selection) <b>; </b>",
                  "numberedInMs": false
                }
              ]
            },
            "er": [],
            "aiSupplement": {
              "explanation": [
                {
                  "text": "Directional selection favours one extreme, stabilising selection favours intermediate phenotypes, and disruptive selection favours both extremes. The predicted distribution must match that pattern.",
                  "refs": [
                    "syllabus:17.2(2)",
                    "ms:a.i#1"
                  ]
                }
              ],
              "reasoningChain": [
                "Identify which phenotypes have higher fitness.",
