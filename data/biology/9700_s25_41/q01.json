        "stem": [
          {
            "type": "text",
            "text": "Identify the type of phosphorylation reaction to synthesise ATP that occurs during glycolysis and the Krebs cycle.",
            "source": {
              "qp": 3
            }
          }
        ],
        "marks": 1,
        "topics": [
          {
            "ref": "12.1(3)",
            "role": "primary"
          }
        ],
        "markScheme": {
          "marks": 1,
          "instruction": null,
          "guidance": [],
          "points": [
            {
              "n": 1,
              "text": "substrate-linked / substrate-level (phosphorylation) <b>; </b>",
              "numberedInMs": false
            }
          ]
        },
        "er": [],
        "aiSupplement": {
          "explanation": [
            {
              "text": "Substrate-level phosphorylation transfers phosphate directly from a phosphorylated intermediate to ADP. Chemiosmosis instead couples proton movement down an electrochemical gradient to ATP synthesis.",
              "refs": [
                "syllabus:12.1(3)",
                "ms:c#1"
              ]
            }
          ],
          "reasoningChain": [
            "Identify the immediate source of the phosphate or energy.",
            "Distinguish direct phosphate transfer from membrane-based chemiosmosis."
          ],
          "inferredMistakes": [
            {
              "text": "Confusing substrate-level phosphorylation with oxidative phosphorylation",
              "basis": "inferred",
              "refs": [
                "syllabus:12.1(3)"
              ]
            }
          ]
        },
        "type": "short"
      },
