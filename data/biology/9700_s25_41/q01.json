            "source": {
              "qp": 2
            }
          },
          {
            "type": "text",
            "text": "Explain the features of ATP that make it suitable to be the universal energy currency of cells.",
            "source": {
              "qp": 2
            }
          }
        ],
        "marks": 4,
        "topics": [
          {
            "ref": "12.1(2)",
            "role": "primary"
          }
        ],
        "markScheme": {
          "marks": 4,
          "instruction": "<i>any </i><b><i>four</i></b><i> from: </i>",
          "guidance": [],
          "points": [
            {
              "n": 1,
              "text": "<b>1 </b> breaks down / hydrolyses to, ADP / AMP, and Pi <b>; </b>",
              "numberedInMs": false
            },
            {
              "n": 2,
              "text": "<b>2 </b> releases, energy / 30.5 kJ mol<sup>-1</sup> <b>; </b>",
              "numberedInMs": false
            },
            {
              "n": 3,
              "text": "<b>3 </b> reversible reaction / high turnover / can be regenerated <b>; </b>",
              "numberedInMs": false
            },
            {
              "n": 4,
              "text": "<b>4 </b> small / soluble, so can, diffuse / move (freely), in cell <b>; </b>",
              "numberedInMs": false
            },
            {
              "n": 5,
              "text": "<b>5 </b> AVP <b>; </b>",
              "numberedInMs": false
            }
          ]
        },
        "er": [],
        "aiSupplement": {
          "explanation": [
            {
              "text": "ATP hydrolysis can be coupled to a reaction requiring energy. Its rapid regeneration supports repeated energy transfers without storing the cell’s entire energy reserve as ATP.",
              "refs": [
                "syllabus:12.1(2)",
                "ms:b#1"
              ]
            }
          ],
          "reasoningChain": [
            "Distinguish immediate energy transfer from long-term energy storage.",
            "Link each property of ATP to its use in cells."
          ],
          "inferredMistakes": [
            {
              "text": "Treating ATP as a long-term energy store",
              "basis": "inferred",
              "refs": [
                "syllabus:12.1(2)"
              ]
            }
          ]
        },
        "type": "short"
      },
