      {
        "type": "text",
        "text": "Organisms need a source of energy for many cellular processes. Respiration involves the release of energy from energy-rich molecules for the synthesis of ATP molecules. ATP is described as the energy currency of cells.",
        "source": {
          "qp": 2
        }
      }
    ],
    "parts": [
      {
        "key": "a",
        "label": "(a)",
        "source": {
