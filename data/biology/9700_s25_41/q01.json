              "n": 1,
              "text": "glucose (phosphate) <b>; </b>",
              "numberedInMs": false
            },
            {
              "n": 2,
              "text": "fructose (phosphate / bisphosphate) <b>; </b>",
              "numberedInMs": false
            },
            {
              "n": 3,
              "text": "triose phosphate <b>; </b>",
              "numberedInMs": false
            },
            {
              "n": 4,
              "text": "(named) fatty acid / keto-acid <b>; </b>",
              "numberedInMs": false
            },
            {
              "n": 5,
              "text": "glycerol <b>; </b>",
              "numberedInMs": false
            },
            {
              "n": 6,
              "text": "amino acid <b>; </b>",
              "numberedInMs": false
            }
          ]
        },
        "er": [],
        "aiSupplement": {
          "explanation": [
            {
              "text": "A respiratory substrate is oxidised to release energy. The amount available depends on its chemical composition and degree of reduction.",
              "refs": [
                "syllabus:12.1(4)",
                "ms:a#1"
              ]
            }
          ],
          "reasoningChain": [
            "Identify molecules that can enter respiratory pathways.",
            "Separate respiratory substrates from intermediates that merely transfer energy."
          ],
          "inferredMistakes": [
