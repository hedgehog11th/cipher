        "stem": [
          {
            "type": "text",
            "text": "In the kidney, various molecules move between the blood and the kidney nephron.",
            "source": {
              "qp": 16
            }
          },
          {
            "type": "text",
            "text": "Table 6.1 describes the movements of molecules at three regions of the nephron, <b>P</b>, <b>Q</b> and <b>R</b>.",
            "source": {
              "qp": 16
            }
          },
          {
            "type": "table",
            "caption": "Table 6.1",
            "head": [
              "<b>region</b> <b>of</b><br><b>nephron</b>",
              "<b>molecule(s)</b>",
              "<b>direction</b> <b>of</b> <b>movement</b>"
            ],
            "rows": [
              [
                "<b>P</b>",
                "amino acids, glucose<br>and water",
                "from nephron to blood"
              ],
              [
                "<b>Q</b>",
                "water",
                "from nephron to blood in the<br>presence of antidiuretic hormone<br>(ADH)"
              ],
              [
                "<b>R</b>",
                "water and molecules<br>with a molecular mass<br>of less than 68,000",
                "from blood to nephron"
              ]
            ]
          }
        ],
        "parts": [
          {
            "key": "a.i",
            "label": "(i)",
            "source": {
              "qp": 16,
              "ms": 14
            },
            "stem": [
              {
                "type": "text",
                "text": "Name the processes, <b>other</b> <b>than</b> diffusion, osmosis and active transport, that are occurring at <b>P</b>, <b>Q</b> and <b>R</b>.",
                "source": {
                  "qp": 16
                }
              },
              {
                "type": "answerLines",
                "labels": [
                  "P",
                  "Q",
                  "R"
                ]
              }
            ],
            "marks": 3,
            "topics": [
              {
                "ref": "14.1(6)",
                "role": "primary"
              }
            ],
            "markScheme": {
              "marks": 3,
              "instruction": null,
              "guidance": [],
              "points": [
                {
                  "n": 1,
                  "text": "<b>P:</b> <u>selective reabsorption</u> <b>; </b>",
                  "numberedInMs": false
                },
                {
                  "n": 2,
                  "text": "<b>Q: </b>osmoregulation <b>; </b>",
                  "numberedInMs": false
                },
                {
                  "n": 3,
                  "text": "<b>R:</b> ultrafiltration <b>; </b>",
                  "numberedInMs": false
                }
              ]
            },
            "er": [],
            "aiSupplement": {
              "explanation": [
                {
                  "text": "Ultrafiltration is driven by pressure across a size-selective barrier. Selective reabsorption returns useful substances to the blood and requires the appropriate transport mechanisms.",
                  "refs": [
                    "syllabus:14.1(6)",
                    "ms:a.i#1"
                  ]
                }
              ],
              "reasoningChain": [
                "Separate filtration from reabsorption.",
                "Identify the location, direction and driving force of each process."
              ],
              "inferredMistakes": [
                {
                  "text": "Describing filtration as active transport",
                  "basis": "inferred",
                  "refs": [
                    "syllabus:14.1(6)"
                  ]
                }
