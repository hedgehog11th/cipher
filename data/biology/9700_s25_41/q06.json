        "stem": [
          {
            "type": "text",
            "text": "A student cut a fresh kidney lengthways and placed one half in the freezer. After 24 hours, the student examined the kidney section and tested its firmness with a mounted needle.",
            "source": {
              "qp": 17
            }
          },
          {
            "type": "text",
            "text": "Sodium chloride concentration affects the freezing point of a solution.",
            "source": {
              "qp": 17
            }
          },
          {
            "type": "text",
            "text": "The student drew the diagram in Fig. 6.1 to show an area that had frozen hard and an area that was softer and less frozen.",
            "source": {
              "qp": 17
            }
          },
          {
            "type": "figure",
            "id": "fig6.1",
            "caption": "Fig. 6.1",
            "src": "figures/q6_fig6_1.png",
            "alt": "Kidney tissue",
            "source": {
              "qp": 17
            }
          },
          {
            "type": "text",
            "text": "Suggest an explanation for the observations in Fig. 6.1 made by the student.",
            "source": {
              "qp": 17
            }
          }
