        "stem": [
          {
            "type": "text",
            "text": "Describe the events that cause each of the potential differences at points <b>X</b>, <b>Y</b> and <b>Z</b>.",
            "source": {
              "qp": 22
            }
          }
        ],
        "marks": 7,
        "topics": [
          {
            "ref": "15.1(6)",
            "role": "primary"
          }
        ],
        "markScheme": {
          "marks": 7,
          "instruction": "<b>causing X</b> / <b>–70 (mV)</b> <i>any </i><b><i>three</i></b><i> from: </i>",
          "guidance": [],
          "points": [
            {
              "n": 1,
              "text": "<b>1 </b> active transport / sodium-potassium pump <b>; </b>",
              "numberedInMs": false
            },
            {
              "n": 2,
              "text": "<b>2 </b> moves three Na<sup>+</sup> out of and two K<sup>+</sup> in (to neurone) <b>; </b>",
              "numberedInMs": false
            },
            {
              "n": 3,
              "text": "<b>3 </b> more K<sup>+</sup> <u>diffuses</u> out than Na<sup>+</sup> <u>diffuses</u> in <b>; </b>",
              "numberedInMs": false
            },
            {
              "n": 4,
              "text": "<b>4 </b> makes outside of membrane (relatively) more positive <b>; </b>",
              "numberedInMs": false
            },
            {
              "n": 5,
              "text": "<b>5 </b> maintaining / establishing, resting potential <b>; </b> <b> </b> <b>causing Y / +40 (mV)</b> <i>any </i><b><i>two</i></b><i> from: </i>",
              "numberedInMs": false
            },
            {
              "n": 6,
              "text": "<b>6 </b> depolarisation <b>; </b>",
              "numberedInMs": false
            },
            {
              "n": 7,
              "text": "<b>7 </b> Na<sup>+</sup> / sodium ion, channels open <b>; </b>",
              "numberedInMs": false
            },
            {
              "n": 8,
              "text": "<b>8 </b> Na<sup>+</sup>, moves / diffuses, in (to neurone) <b>; </b> <b> </b> <b>causing Z / –90 (mV)</b> <i>any </i><b><i>two</i></b><i> from: </i>",
              "numberedInMs": false
            },
            {
              "n": 9,
              "text": "<b>9 </b> hyperpolarisation <b>; </b>",
              "numberedInMs": false
            },
            {
              "n": 10,
              "text": "<b>10 </b>(voltage-gated) K<sup>+</sup> / potassium ion, channels open <b>; </b>",
              "numberedInMs": false
            },
            {
              "n": 11,
              "text": "<b>11 </b>K<sup>+</sup>, moves / diffuses, out (of neurone) <b>; </b>",
              "numberedInMs": false
            }
          ]
        },
        "er": [],
