            "markScheme": {
              "marks": 2,
              "instruction": "<i>any <b>two</b> from:</i>",
              "guidance": [],
              "points": [
                {
                  "n": 1,
                  "text": "affects, rib muscles / intercostal muscles / diaphragm, so unable to breathe <b>;</b>"
                },
                {
                  "n": 2,
                  "text": "affects cardiac muscle so, stops blood circulation / heart failure / attack <b>;</b>"
                },
                {
                  "n": 3,
                  "text": "cannot move so unable to escape from predators <b>;</b>"
                },
                {
                  "n": 4,
                  "text": "cannot eat so starves <b>;</b>"
                }
              ],
              "source": {
                "ms": 18
              }
            },
            "er": [
              "er.q9.b.ii"
            ],
            "aiSupplement": {
              "explanation": [
                {
                  "text": "Connect paralysis to a vital function rather than stopping at the word paralysis. Inability to ventilate the lungs prevents sustained oxygen delivery to tissues.",
                  "refs": [
                    "ms:b.ii#1",
                    "ms:b.ii#2",
                    "ms:b.ii#3",
                    "ms:b.ii#4"
                  ]
                }
              ],
              "reasoningChain": [
                "Identify a muscle-dependent vital function.",
                "Explain the immediate functional loss.",
                "Link the loss to a cause of death."
              ],
              "inferredMistakes": []
            }
          }
