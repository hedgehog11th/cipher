            "stem": [
              {
                "type": "text",
                "text": "State what happens to the A-band and the I-band when the sarcomere contracts.",
                "source": {
                  "qp": 24
                }
              },
              {
                "type": "answerLines",
                "labels": [
                  "A-band",
                  "I-band"
                ]
              }
            ],
            "topics": [
              {
                "ref": "15.1(12)",
                "role": "primary"
              }
            ],
            "markScheme": {
              "marks": 2,
              "instruction": null,
              "guidance": [],
              "points": [
                {
                  "n": 1,
                  "text": "A-band – stays the same <b>;</b>",
                  "numberedInMs": false
                },
                {
                  "n": 2,
                  "text": "<b>I</b>-band – gets narrower <b>;</b>",
                  "numberedInMs": false
                }
              ],
              "source": {
                "ms": 17
              }
            },
            "er": [
              "er.q9.a.ii"
            ],
            "aiSupplement": {
              "explanation": [
                {
                  "text": "Band widths depend on filament length and overlap. Sliding changes overlap without shortening either actin or myosin filaments.",
                  "refs": [
                    "ms:a.ii#1",
                    "ms:a.ii#2"
                  ]
                }
              ],
              "reasoningChain": [
                "Identify the band containing the full myosin length.",
                "Identify the region containing only actin.",
                "Apply increased filament overlap during contraction."
              ],
              "inferredMistakes": []
            }
          }
        ]
      },
      {
        "key": "b",
        "label": "(b)",
        "source": {
          "qp": 24
        },
        "stem": [
          {
            "type": "text",
            "text": "The plant <i>Strychnos toxifera</i> produces the toxin curare, which can cause muscle paralysis in mammals.",
            "source": {
              "qp": 24
            }
          },
          {
            "type": "text",
            "text": "The toxin acts by binding to receptors on the cell surface membranes (sarcolemma) of muscle cells at neuromuscular junctions.",
            "source": {
              "qp": 24
            }
          }
        ],
        "parts": [
          {
            "key": "b.i",
            "label": "(i)",
            "type": "short",
            "marks": 4,
            "source": {
              "qp": 24,
              "ms": 18
            },
            "stem": [
              {
                "type": "text",
                "text": "Suggest how binding of curare to receptors may cause muscle paralysis.",
                "source": {
                  "qp": 24
                }
              }
            ],
            "topics": [
              {
                "ref": "15.1(10)",
                "role": "primary"
              },
              {
                "ref": "15.1(12)",
                "role": "secondary"
              }
            ],
            "markScheme": {
              "marks": 4,
              "instruction": "<i>any <b>four</b> from:</i>",
              "guidance": [],
              "points": [
                {
                  "n": 1,
                  "text": "competes with, acetylcholine / neurotransmitter<br><b>or</b><br>acetylcholine cannot bind to receptors<br><b>or</b><br>blocks receptors <b>;</b>"
                },
                {
                  "n": 2,
                  "text": "Na<sup>+</sup> channels do not open<br><b>or</b><br>no / fewer, sodium ions enter (muscle fibre) <b>;</b>"
                },
                {
                  "n": 3,
                  "text": "so, no / less, depolarisation of sarcolemma <b>;</b>"
                },
                {
                  "n": 4,
                  "text": "no / fewer, action potentials / impulses (spread across muscle fibre) <b>;</b>"
                },
                {
                  "n": 5,
                  "text": "Ca<sup>2+</sup> (voltage-gated) channels do not open in sarcoplasmic reticulum<br><b>or</b><br>no / fewer, Ca<sup>2+</sup> ions released by sarcoplasmic reticulum <b>;</b>"
                },
                {
                  "n": 6,
                  "text": "no / fewer, Ca<sup>2+</sup> ions bind to troponin<br><b>or</b><br>no exposing of binding sites<br><b>or</b><br>no / fewer, cross bridges / AW <b>;</b>"
                }
              ],
              "source": {
                "ms": 18
              }
            },
            "er": [
              "er.q9.b.i"
            ],
            "aiSupplement": {
              "explanation": [
                {
                  "text": "Trace the interruption from the muscle-cell surface to the contractile proteins. Blocking receptor activation prevents the electrical signal that normally links the neuromuscular junction to calcium release inside the fibre.",
                  "refs": [
                    "ms:b.i#1",
                    "ms:b.i#2",
                    "ms:b.i#3",
                    "ms:b.i#4",
                    "ms:b.i#5",
                    "ms:b.i#6"
                  ]
                }
              ],
              "reasoningChain": [
                "Start with blocked acetylcholine receptors.",
                "Follow reduced depolarisation and action-potential propagation.",
                "Connect reduced calcium release to fewer cross bridges."
              ],
              "inferredMistakes": []
            }
          },
          {
