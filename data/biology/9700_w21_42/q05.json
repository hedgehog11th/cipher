          {
            "type": "text",
            "text": "Prairie strips are restored habitat areas planted with native grasses and wildflowers. Prairie strips are usually located between or around the edges of fields of maize or soy bean.",
            "source": {
              "qp": 15
            }
          },
          {
            "type": "text",
            "text": "Students in North America wanted to investigate biodiversity along a prairie strip.",
            "source": {
              "qp": 15
            }
          }
        ],
