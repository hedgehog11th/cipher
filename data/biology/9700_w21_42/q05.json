        "stem": [
          {
            "type": "text",
            "text": "Prairie strips have environmental and economic effects.",
            "source": {
              "qp": 16
            }
          },
          {
            "type": "text",
            "text": "Scientists have made long-term measurements of the environmental effects of prairie strips.",
            "source": {
              "qp": 16
            }
          },
          {
            "type": "text",
            "text": "The scientists found that when prairie strips formed 10% of a crop-field:",
            "source": {
              "qp": 16
            }
          },
          {
            "type": "list",
            "items": [
              "soil erosion decreased by 95%",
              "mineral loss from the field decreased by 90% for phosphorus compounds",
              "mineral loss from the field decreased by 85% for nitrogen compounds."
            ],
            "source": {
              "qp": 16
            }
          },
          {
            "type": "text",
            "text": "Crop plants need phosphorus (P) and nitrogen (N) to grow.",
            "source": {
              "qp": 16
            }
          },
          {
            "type": "text",
            "text": "Evaluate the <b>economic</b> effects of prairie strips on farming.",
            "source": {
              "qp": 16
            }
          }
        ],
        "topics": [
          {
            "ref": "18.3(2)",
            "role": "primary"
          }
        ],
        "markScheme": {
          "marks": 3,
          "instruction": "<i>any </i><b><i>three</i></b><i> from: </i><br><i>negative </i>",
          "guidance": [],
          "points": [
            {
              "n": 1,
              "text": "smaller crop area so lower yield <b>; </b>"
            },
            {
              "n": 2,
              "text": "prairie strip insects may feed on crop <b>; </b>"
            },
            {
              "n": 3,
              "text": "(so) less, profit / income<b> ; </b><i>must be linked to mp1 or mp2</i>"
            },
            {
