            "markScheme": {
              "marks": 2,
              "instruction": null,
              "guidance": [],
              "points": [
                {
                  "n": 1,
                  "text": "(more cristae results in) <b>more</b>, ETC / (named) carrier proteins / ATP synthase <b>; </b><br><b>or </b><br>(more cristae results in) <b>more</b>, oxidative phosphorylation / chemiosmosis / ATP synthesis <b>; </b>"
                },
                {
                  "n": 2,
                  "text": "(because) cardiac muscle must undergo continuous contractions / AW<b> ; </b>"
