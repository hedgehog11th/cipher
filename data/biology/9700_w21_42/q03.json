        "stem": [
          {
            "type": "text",
            "text": "In the malting process, germination is stopped before the concentration of sugars in the germinating barley seeds exceeds a concentration that causes shoot or root growth.",
            "source": {
              "qp": 10
            }
          },
          {
            "type": "text",
            "text": "Drying the germinating barley seeds at 50 °C is one method used to stop malting.",
            "source": {
              "qp": 10
            }
          }
        ],
