        "stem": [
          {
            "type": "text",
            "text": "Malting is a process involved in the production of a drink called beer. During malting, barley seed germination is controlled so that the sugars produced during germination can be used in the production of beer.",
            "source": {
              "qp": 9
            }
          },
          {
            "type": "text",
            "text": "Fig. 3.1 shows two features of a germinating barley seed during the first five days of malting:",
            "source": {
              "qp": 9
            }
          },
          {
            "type": "list",
            "items": [
              "activity of the amylase enzyme",
              "the percentage of starch reserves remaining in the barley seed."
            ],
            "source": {
              "qp": 9
            }
          },
          {
            "type": "figure",
            "id": "fig3.1",
            "caption": "Fig. 3.1",
            "src": "figures/q3_fig3_1.png",
            "alt": "Dual-axis graph of increasing amylase activity and decreasing percentage of starch reserves during five days of malting, with a key for the two curves.",
            "source": {
              "qp": 9
            }
          }
        ],
