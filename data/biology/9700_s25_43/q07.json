        "stem": [
          {
            "type": "text",
            "text": "Paper chromatography is a technique that can be used to separate a mixture of four common chloroplast pigments. The pigments can be identified by calculating their R<sub>f</sub> values.",
            "source": {
              "qp": 14
            }
          },
          {
            "type": "text",
            "text": "A student carried out paper chromatography on a solution containing a mixture of chloroplast pigments.",
            "source": {
              "qp": 14
            }
          },
          {
            "type": "text",
            "text": "The results are shown in Table 7.1.",
            "source": {
              "qp": 14
            }
          },
