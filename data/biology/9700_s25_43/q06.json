        "markScheme": {
          "marks": 7,
          "instruction": "<i>any </i><b><i>seven</i></b><i> from: </i>",
          "guidance": [],
          "points": [
            {
              "n": 1,
              "text": "1  blood enters glomerulus via afferent arteriole <b>;</b>",
              "numberedInMs": false
            },
            {
              "n": 2,
              "text": "2  afferent arteriole (lumen) diameter larger than efferent <b>;</b>",
              "numberedInMs": false
            },
            {
              "n": 3,
              "text": "3  (so) high, blood / hydrostatic, pressure<b> ; </b> <b> </b>",
              "numberedInMs": false
            },
            {
              "n": 4,
              "text": "4  blood / hydrostatic, pressure greater than water potential gradient (between Bowman’s capsule and glomerulus) <b>;</b>",
              "numberedInMs": false
            },
            {
              "n": 5,
              "text": "5  fluid forced through pores / fenestrations in (blood vessel) endothelium <b>; </b>",
              "numberedInMs": false
