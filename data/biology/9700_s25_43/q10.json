        "stem": [
          {
            "type": "text",
            "text": "One way of estimating the size of a population of golden poison dart frogs is to use the mark-release-recapture method.",
            "source": {
              "qp": 21
            }
          }
        ],
        "parts": [
          {
            "key": "b.i",
            "label": "(i)",
            "source": {
              "qp": 21,
              "ms": 20
            },
            "stem": [
              {
                "type": "text",
                "text": "Suggest the assumptions that must be made for the mark-release-recapture method to be valid.",
                "source": {
                  "qp": 21
                }
              }
            ],
            "marks": 3,
            "topics": [
              {
                "ref": "18.2(4)",
                "role": "primary"
              }
            ],
            "markScheme": {
              "marks": 3,
              "instruction": "<i>any </i><b><i>three</i></b><i> from: </i>",
              "guidance": [],
              "points": [
                {
                  "n": 1,
                  "text": "1  (frogs are) mobile <b>; </b>",
                  "numberedInMs": false
                },
                {
                  "n": 2,
                  "text": "2  marking, not harmful / cannot be removed <b>; </b> <b> </b>",
                  "numberedInMs": false
                },
                {
                  "n": 3,
                  "text": "3  (sufficient time for) marked individuals to mix with rest of population <b>;</b> <b> </b>",
                  "numberedInMs": false
                },
                {
                  "n": 4,
                  "text": "4  no, births / deaths <b>or </b> no, immigration / emigration / migration <b>or </b> <b> </b> constant population size <b>; </b>",
                  "numberedInMs": false
                }
              ]
            },
            "er": [],
            "aiSupplement": {
              "explanation": [
                {
                  "text": "Sampling should represent the population or area being estimated. Mark–release–recapture also assumes that marked animals mix and retain marks without altered capture probability.",
                  "refs": [
                    "syllabus:18.2(4)",
                    "ms:b.i#1"
                  ]
