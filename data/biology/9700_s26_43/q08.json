          {
            "type": "text",
            "text": "The plant hormone auxin has an important role in the growth of plants. When auxin molecules bind to receptors in the cell surface membrane of young cells, a series of events is triggered that results in cell elongation.",
            "source": {
              "qp": 19
            }
          },
          {
            "type": "text",
            "text": "Figure 8.2 outlines this series of events.",
            "source": {
              "qp": 19
            }
          },
          {
            "type": "figure",
            "id": "fig8.2",
            "caption": "Figure 8.2",
            "src": "figures/q8_fig8_2.png",
            "alt": "Three events in auxin-stimulated cell elongation with A, B and water movements.",
            "source": {
              "qp": 19
            }
          }
        ],
        "parts": [
          {
            "key": "b.i",
            "label": "(i)",
            "source": {
              "qp": 19,
              "ms": 17
            },
            "stem": [
              {
                "type": "text",
                "text": "Describe event 1 in Figure 8.2 <b>and</b> explain how this event is important for the process of cell elongation.",
                "source": {
                  "qp": 19
                }
              }
            ],
            "marks": 3,
            "markScheme": {
              "marks": 3,
              "instruction": "<i>any </i><b><i>three </i></b><i>from: </i>",
              "guidance": [],
              "points": [
