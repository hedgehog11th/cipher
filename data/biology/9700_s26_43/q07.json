        },
        "stem": [
          {
            "type": "text",
            "text": "Ring-tailed lemurs are classified as endangered on the International Union for Conservation of Nature (IUCN) Red List of Threatened Species<sup>TM</sup>. There are approximately 2000 ring-tailed lemurs in the wild in Madagascar.",
            "source": {
              "qp": 15
            }
          },
          {
            "type": "text",
            "text": "Suggest reasons why the ring-tailed lemur has become endangered.",
            "source": {
              "qp": 15
            }
          }
        ],
        "marks": 3,
        "markScheme": {
          "marks": 3,
          "instruction": "<i>any </i><b><i>three </i></b><i>from: </i>",
          "guidance": [],
          "points": [
            {
              "n": 1,
              "text": "habitat, destruction / loss <b>;</b> <b>A</b> deforestation"
            },
            {
              "n": 2,
              "text": "reduction in, food (supply) / prey (numbers) <b>or </b> increased competition for food <b>; </b>"
            },
            {
              "n": 3,
              "text": "hunted (by humans) for, food / bushmeat  <b>or </b> increased predation <b>; A </b>new predator"
            },
            {
              "n": 4,
              "text": "(named) climate change <b>;</b> e.g. drought / global warming"
            },
            {
              "n": 5,
              "text": "<b>new</b> disease <b>;</b>"
            },
            {
              "n": 6,
              "text": "illegal pet trade <b>;</b>"
            }
          ],
          "source": {
            "ms": 15
          },
          "note": "Point n follows the order of the transcribed marking points; table rows or source labels such as 3a and 3b retain their original wording."
        },
        "topics": [
