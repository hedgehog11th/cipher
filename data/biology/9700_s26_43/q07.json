            "key": "c.i",
            "label": "(i)",
            "source": {
              "qp": 16,
              "ms": 16
            },
            "stem": [
              {
                "type": "text",
                "text": "The mark-release-recapture method was used to estimate the size of a population of the hissing cockroach.",
                "source": {
                  "qp": 16
                }
              },
              {
                "type": "list",
                "items": [
                  "33 cockroaches were trapped, marked and released.",
                  "A few days later 46 cockroaches were trapped, of which 9 were marked."
                ],
                "source": {
                  "qp": 16
                }
              },
              {
                "type": "text",
                "text": "The Lincoln index is used to estimate the size of a population.",
                "source": {
                  "qp": 16
                }
              },
              {
                "type": "text",
                "text": "The formula for the Lincoln index is:",
                "source": {
                  "qp": 16
