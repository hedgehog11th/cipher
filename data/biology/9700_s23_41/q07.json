        "er": [],
        "aiSupplement": {
          "explanation": [
            {
              "text": "Compare the carbon skeletons that remain after removal of amino groups: pyruvate has three carbons and oxaloacetate has four. This structural inference has no separate syllabus outcome; it is linked to amino acid deamination and the respiratory intermediates named in the question.",
              "refs": [
                "ms:a#1",
