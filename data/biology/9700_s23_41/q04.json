              "ms": 11
            },
            "stem": [
              {
                "type": "text",
                "text": "Define the term recombinant DNA.",
                "source": {
                  "qp": 10
                }
              }
            ],
            "topics": [
              {
                "ref": "19.1(1)",
                "role": "primary"
              }
            ],
            "markScheme": {
              "instruction": null,
              "guidance": [],
              "points": [
                {
                  "n": 1,
                  "text": "DNA, combined / joined, from, two / different, organisms / sources <b>; </b>",
                  "numberedInMs": false
                }
