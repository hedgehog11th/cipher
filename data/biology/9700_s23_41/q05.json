    "stem": [
      {
        "type": "text",
        "text": "The kidney is an important organ of homeostasis. One role of the kidney is osmoregulation.",
        "source": {
          "qp": 13
        }
      }
    ],
    "parts": [
      {
        "key": "a",
        "label": "(a)",
        "source": {
          "qp": 13
        },
        "stem": [
          {
            "type": "text",
            "text": "Fig. 5.1 is a photomicrograph of part of a kidney nephron.",
            "source": {
              "qp": 13
            }
          },
          {
            "type": "figure",
            "id": "fig5.1",
            "caption": "Fig. 5.1",
            "src": "figures/q5_fig5_1.png",
            "alt": "Kidney nephron photomicrograph with structures A and B labelled and magnification ×900.",
            "source": {
              "qp": 13
            }
          }
        ],
        "parts": [
          {
            "key": "a.i",
            "type": "short",
            "marks": 2,
            "source": {
              "qp": 13,
              "ms": 12
            },
            "stem": [
              {
                "type": "text",
                "text": "Identify the structures labelled <b>A</b> and <b>B</b> in Fig. 5.1.",
                "source": {
                  "qp": 13
                }
              },
              {
                "type": "answerLines",
                "labels": [
                  "<b>A</b>",
                  "<b>B</b>"
                ]
              }
            ],
            "topics": [
              {
                "ref": "14.1(5)",
                "role": "primary"
              }
            ],
            "markScheme": {
              "instruction": null,
              "guidance": [],
              "points": [
                {
                  "n": 1,
                  "text": "<b>A</b> = glomerulus <b>; </b>",
                  "numberedInMs": false
                },
                {
                  "n": 2,
                  "text": "<b>B </b>= Bowman’s capsule<b> ;</b>",
                  "numberedInMs": false
                }
              ],
              "source": {
                "ms": 12
              },
              "marks": 2
            },
            "er": [],
            "aiSupplement": {
              "explanation": [
                {
                  "text": "The glomerulus is the capillary tuft. The surrounding Bowman’s capsule encloses the space into which the filtrate is collected.",
                  "refs": [
                    "ms:a.i#1",
                    "ms:a.i#2",
                    "syllabus:14.1(5)"
                  ]
                }
              ],
              "reasoningChain": [
                "Follow each label line to its endpoint.",
                "Distinguish the capillary tuft from the surrounding capsule."
              ],
              "inferredMistakes": []
            },
            "label": "(i)"
          },
          {
            "key": "a.ii",
            "type": "extended",
            "marks": 4,
            "source": {
              "qp": 13,
              "ms": 12
            },
            "stem": [
              {
                "type": "text",
                "text": "Describe how blood is filtered by the part of the kidney nephron shown in Fig. 5.1.",
                "source": {
                  "qp": 13
                }
              }
            ],
            "topics": [
              {
                "ref": "14.1(6)",
                "role": "primary"
              },
              {
                "ref": "14.1(7)",
                "role": "secondary"
              }
            ],
            "markScheme": {
              "instruction": "<i>any </i><b><i>four</i></b><i> from: </i>",
              "guidance": [],
              "points": [
                {
                  "n": 1,
                  "text": "ultrafiltration <b>; </b>"
                },
                {
                  "n": 2,
                  "text": "high(er) pressure due to afferent arteriole wider than efferent arteriole <b>; </b>"
                },
                {
                  "n": 3,
                  "text": "capillary endothelium has, fenestrations / gaps / holes / pores<b> ; </b>"
                },
                {
                  "n": 4,
                  "text": "small molecules / (named) ions / glucose / amino acids / urea / water, <b>and </b> <b>EITHER</b> leave, blood / plasma / capillary / glomerulus <b>OR</b> enter, capsule / filtrate / tubule <b>; </b>"
                },
                {
                  "n": 5,
                  "text": "basement membrane forms, (main) filtration / selective, barrier <b>; </b>"
                },
                {
                  "n": 6,
                  "text": "(R)MM / M<sub>r</sub>, limit of, 68 000 to 70 000 (Da) / 68–70 kDa <b>; </b>"
                },
                {
                  "n": 7,
                  "text": "podocytes, form slit pores / support basement membrane <b>; </b>"
                }
              ],
              "source": {
                "ms": 12
              },
              "marks": 4
            },
            "er": [],
            "aiSupplement": {
              "explanation": [
                {
                  "text": "High hydrostatic pressure drives water and small solutes out of glomerular capillaries. The endothelial openings, basement membrane and podocyte slit system together permit filtration while retaining blood cells and large plasma proteins.",
                  "refs": [
                    "ms:a.ii#1",
                    "ms:a.ii#2",
                    "ms:a.ii#3",
                    "ms:a.ii#4",
                    "ms:a.ii#5",
                    "ms:a.ii#6",
                    "ms:a.ii#7",
                    "syllabus:14.1(6)"
                  ]
                }
              ],
              "reasoningChain": [
                "Explain the pressure difference.",
                "Trace small molecules through the filtration barrier into Bowman’s capsule."
              ],
              "inferredMistakes": []
            },
            "label": "(ii)"
          }
        ]
      },
      {
        "key": "b",
        "label": "(b)",
        "source": {
          "qp": 14
        },
        "stem": [
          {
            "type": "text",
            "text": "The cell surface membranes of kidney cells have receptors for many molecules, including glucagon and antidiuretic hormone (ADH).",
            "source": {
              "qp": 14
            }
          }
        ],
        "parts": [
          {
            "key": "b.i",
            "type": "short",
            "marks": 2,
            "source": {
              "qp": 14,
              "ms": 12
            },
            "stem": [
              {
                "type": "text",
                "text": "Glucagon binds to G-protein-coupled receptors on kidney cells.",
                "source": {
                  "qp": 14
                }
              },
              {
                "type": "text",
                "text": "The binding of glucagon to kidney cells activates a cell signalling pathway that is similar to the cell signalling pathway activated when glucagon binds to liver cells.",
                "source": {
                  "qp": 14
                }
              },
              {
                "type": "text",
                "text": "Fig. 5.2 is an outline of the cell signalling pathway activated when glucagon binds to kidney cells.",
                "source": {
                  "qp": 14
                }
              },
              {
                "type": "figure",
                "id": "fig5.2",
                "caption": "Fig. 5.2",
                "src": "figures/q5_fig5_2.png",
                "alt": "Glucagon-activated cell signalling pathway in a kidney cell, with molecules C and D labelled.",
                "source": {
                  "qp": 14
                }
              },
              {
                "type": "text",
                "text": "Name the molecules labelled <b>C</b> and <b>D</b> in Fig. 5.2.",
                "source": {
                  "qp": 14
                }
              },
              {
                "type": "answerLines",
                "labels": [
                  "<b>C</b>",
                  "<b>D</b>"
                ]
              }
            ],
            "topics": [
              {
                "ref": "14.1(9)",
                "role": "primary"
              }
            ],
            "markScheme": {
              "instruction": null,
              "guidance": [],
              "points": [
                {
                  "n": 1,
                  "text": "<b>C</b> adenyl(yl) cyclase <b>; </b>",
                  "numberedInMs": false
                },
                {
                  "n": 2,
                  "text": "<b>D</b> c(yclic) AMP <b>;</b>",
                  "numberedInMs": false
                }
              ],
              "source": {
                "ms": 12
              },
              "marks": 2
            },
            "er": [],
            "aiSupplement": {
              "explanation": [
                {
                  "text": "The activated G-protein stimulates adenylyl cyclase. This enzyme forms cyclic AMP from ATP; cAMP then acts as the intracellular second messenger that activates protein kinase A.",
                  "refs": [
                    "ms:b.i#1",
                    "ms:b.i#2",
                    "syllabus:14.1(9)"
                  ]
                }
              ],
              "reasoningChain": [
                "Identify the membrane-associated enzyme.",
                "Identify its ATP-derived second messenger."
              ],
              "inferredMistakes": []
            },
            "label": "(i)"
          },
          {
            "key": "b.ii",
            "type": "data-interpretation",
            "marks": 4,
            "source": {
              "qp": 15,
              "ms": 12
            },
            "stem": [
              {
                "type": "text",
                "text": "Syndrome of inappropriate antidiuresis (SIAD) is a condition that affects osmoregulation in the kidney.",
                "source": {
                  "qp": 15
                }
              },
              {
                "type": "text",
                "text": "Fig. 5.3 shows how sodium ion concentration in the blood affects the ADH concentration in the blood in:",
                "source": {
                  "qp": 15
                }
              },
              {
                "type": "list",
                "items": [
                  "people with normal homeostasis",
                  "people with one type of SIAD, known as type C SIAD."
                ],
                "source": {
                  "qp": 15
                }
              },
              {
                "type": "figure",
                "id": "fig5.3",
                "caption": "Fig. 5.3",
                "src": "figures/q5_fig5_3.png",
                "alt": "ADH concentration plotted against blood sodium ion concentration, comparing normal homeostasis and type C SIAD.",
                "source": {
                  "qp": 15
                }
              },
              {
                "type": "text",
                "text": "Describe the results shown in Fig. 5.3 <b>and</b> explain the effect of type C SIAD on osmoregulation.",
                "source": {
                  "qp": 15
                }
              }
            ],
            "topics": [
              {
                "ref": "14.1(8)",
                "role": "primary"
              }
            ],
            "markScheme": {
              "instruction": "<i>any </i><b><i>four</i></b><i> from</i>:",
              "guidance": [],
              "points": [
                {
                  "n": 1,
                  "text": "in both as Na<sup>+</sup> concentration increases ADH concentration increases (after a, certain / stated, point) <b>; </b>"
                },
                {
                  "n": 2,
                  "text": "in, type C / SIAD, ADH rise occurs at a lower Na<sup>+</sup> concentration <b>; </b>"
                },
                {
                  "n": 3,
                  "text": "comparative figures <b>; </b>"
                },
                {
                  "n": 4,
                  "text": "(ADH →) more aquaporins / greater permeability to water, in collecting duct / DCT <b>; </b>"
                },
                {
                  "n": 5,
                  "text": "(C / SIAD / ADH →) more water reabsorbed, at collecting duct / at DCT / into blood<b> ; </b>"
                },
                {
                  "n": 6,
                  "text": "(C / SIAD / ADH →) small(er) volume of / (more) concentrated, urine <b>; </b>"
                },
                {
                  "n": 7,
                  "text": "type C / SIAD, causes, high blood water potential / low blood Na<sup>+</sup> concentration <b>;</b>"
                }
              ],
              "source": {
                "ms": 12
              },
              "marks": 4
            },
            "er": [],
            "aiSupplement": {
              "explanation": [
                {
                  "text": "A lower sodium concentration threshold for ADH release allows ADH to remain high when normal feedback would suppress it. More collecting-duct aquaporins increase water reabsorption, giving smaller volumes of concentrated urine and diluting the blood.",
                  "refs": [
                    "ms:b.ii#1",
                    "ms:b.ii#2",
                    "ms:b.ii#3",
                    "ms:b.ii#4",
                    "ms:b.ii#5",
                    "ms:b.ii#6",
                    "ms:b.ii#7",
                    "syllabus:14.1(8)"
                  ]
                }
              ],
              "reasoningChain": [
                "Compare the curves at the same sodium concentration.",
                "Link higher ADH to collecting-duct water permeability and urine changes."
              ],
              "inferredMistakes": []
            },
            "label": "(ii)"
          }
        ]
      }
