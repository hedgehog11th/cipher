              "qp": 16,
              "ms": 12
            },
            "stem": [
              {
                "type": "text",
                "text": "List the <b>four</b> possible genotypes of the rabbit shown in Fig. 6.1.",
                "source": {
                  "qp": 16
                }
              }
            ],
            "topics": [
              {
                "ref": "16.2(2)",
                "role": "primary"
              }
            ],
            "markScheme": {
              "instruction": null,
              "guidance": [],
              "points": [
                {
                  "n": 1,
                  "text": "<b>AAb<sup>h</sup>b<sup>h</sup><br>Aab<sup>h</sup>b<sup>h</sup><br>AAb<sup>h</sup>b<br>Aab<sup>h</sup>b ; ;</b>",
                  "numberedInMs": false
                }
              ],
              "source": {
                "ms": 12
              },
              "marks": 2
            },
            "er": [],
            "aiSupplement": {
              "explanation": [
                {
                  "text": "Short fur requires at least one A allele. A Himalayan coat requires b<sup>h</sup> without the dominant B allele; the second colour allele can be b<sup>h</sup> or b. Combining the two length possibilities with the two colour possibilities gives four genotypes.",
                  "refs": [
                    "ms:a.i#1",
                    "syllabus:16.2(2)"
                  ]
                }
              ],
              "reasoningChain": [
                "List the possible genotypes at each locus.",
                "Combine the possibilities while retaining the dominance hierarchy."
              ],
              "inferredMistakes": []
            },
            "label": "(i)"
          },
          {
            "key": "a.ii",
            "type": "short",
            "marks": 1,
            "source": {
              "qp": 16,
              "ms": 13
            },
            "stem": [
              {
                "type": "text",
                "text": "One phenotype of rabbit always breeds true. This means that when it is mated to a rabbit that looks the same as itself, all the offspring look the same as the parents.",
                "source": {
                  "qp": 16
                }
              },
              {
                "type": "text",
                "text": "Describe the <b>phenotype</b> of the rabbit that breeds true.",
                "source": {
                  "qp": 16
                }
              }
            ],
            "topics": [
              {
                "ref": "16.2(1)",
                "role": "primary"
              }
            ],
            "markScheme": {
              "instruction": null,
              "guidance": [],
              "points": [
                {
                  "n": 1,
                  "text": "long, white / albino <b>; </b>",
                  "numberedInMs": false
                }
              ],
              "source": {
                "ms": 13
              },
              "marks": 1
            },
            "er": [],
            "aiSupplement": {
              "explanation": [
                {
                  "text": "The phenotype that guarantees homozygosity at both loci is the double recessive phenotype. Crosses between those rabbits cannot introduce a dominant allele into their offspring.",
                  "refs": [
                    "ms:a.ii#1",
                    "syllabus:16.2(1)"
                  ]
                }
              ],
              "reasoningChain": [
                "Find the recessive phenotype at each locus.",
                "Combine them to identify the phenotype that always breeds true."
              ],
              "inferredMistakes": []
            },
            "label": "(ii)"
          }
        ]
      },
