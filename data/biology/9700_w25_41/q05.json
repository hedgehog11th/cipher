              "guidance": [],
              "points": [
                {
                  "n": 1,
                  "text": "<b>1</b>    (<b>D</b> / it)<b>,</b> shortens / contracts / decreases <b>; </b> <b> </b> <i>and any </i><b><i>three</i></b><i> from: </i>",
