              "guidance": [],
              "points": [
                {
                  "n": 1,
                  "text": "<b>1</b>    large groups divide into smaller groups <b>; </b>",
                  "numberedInMs": false
                },
                {
                  "n": 2,
                  "text": "<b>2</b>    common / similar / shared, features within a group <b>; </b>",
                  "numberedInMs": false
                },
                {
                  "n": 3,
                  "text": "<b>3</b>    <i>ref. three of:</i> kingdom – phylum – class – order – family<b> ; </b>",
                  "numberedInMs": false
