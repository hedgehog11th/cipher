            "markScheme": {
              "marks": 1,
              "instruction": null,
              "guidance": [],
              "points": [
                {
                  "n": 1,
                  "text": "continuous <b>; </b>",
                  "numberedInMs": false
                }
              ]
            },
            "er": [],
            "aiSupplement": {
              "explanation": [
                {
                  "text": "Continuous variation spans a range with intermediate values. Discontinuous variation places individuals in distinct categories without intermediate phenotypes.",
                  "refs": [
                    "syllabus:17.1(2)",
                    "ms:b.ii#1"
                  ]
                }
              ],
              "reasoningChain": [
                "Identify whether intermediate values occur.",
                "Describe the distribution rather than only naming a cause."
              ],
              "inferredMistakes": [
                {
                  "text": "Defining continuous variation only as variation caused by the environment",
                  "basis": "inferred",
                  "refs": [
                    "syllabus:17.1(2)"
                  ]
                }
              ]
            },
            "type": "short"
          },
          {
