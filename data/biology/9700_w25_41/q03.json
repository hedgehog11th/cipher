        "stem": [
          {
            "type": "text",
            "text": "Fig. 3.2 shows the absorption spectra of some chloroplast pigments.",
            "source": {
              "qp": 8
            }
          },
          {
            "type": "figure",
            "id": "fig3.2",
            "caption": "Fig. 3.2",
            "src": "figures/q3_fig3_2.png",
            "alt": "Absorption spectra of pigments",
            "source": {
              "qp": 8
            }
          },
          {
            "type": "text",
            "text": "Use Fig. 3.2 to compare the similarities and differences between the absorption spectra of chlorophyll <i>a</i> and carotenoids.",
            "source": {
              "qp": 8
            }
          }
        ],
        "marks": 4,
        "topics": [
          {
            "ref": "13.1(5)",
            "role": "primary"
          }
        ],
        "markScheme": {
          "marks": 4,
          "instruction": "<i>any </i><b><i>four</i></b><i> from</i>:  <i>similarities </i>",
          "guidance": [],
          "points": [
            {
              "n": 1,
              "text": "<b>1</b>    both absorb, blue / between 400 and 475 nm<b> ; </b>",
              "numberedInMs": false
            },
            {
              "n": 2,
              "text": "<b>2</b>    both absorb, little / no, light between 525 and, 600 / 630, nm <b>or</b> both absorb, little / no, green / yellow, light <b>; </b>",
              "numberedInMs": false
            },
            {
              "n": 3,
              "text": "<b>3</b>    AVP <b>; </b> <b> </b> <b> </b> <i>max three differences </i>",
              "numberedInMs": false
            },
            {
              "n": 4,
              "text": "<b>4</b>    chlorophyll <i>a</i> absorbs, at more / a larger range of, wavelengths <b>; </b>",
              "numberedInMs": false
            },
            {
              "n": 5,
              "text": "<b>5</b>    chlorophyll <i>a</i> absorbs, more / better, between 400 and 445 nm <b>; </b>",
              "numberedInMs": false
            },
            {
              "n": 6,
              "text": "<b>6 </b> <b> </b> carotenoids absorb, more / better, between 445 and 525 nm<b> ; </b>",
              "numberedInMs": false
            },
            {
              "n": 7,
              "text": "<b>7</b>    chlorophyll <i>a</i> absorbs between, 600 / 640, and, 680 / 690 nm,<b> </b><u>and</u><b> </b>carotenoids do not<b> ; </b> <b> </b>",
              "numberedInMs": false
            },
            {
              "n": 8,
              "text": "<b>8 </b> <b> </b> chlorophyll <i>a </i>(blue absorption) peak / highest, at 425 / 430 nm <u>and</u> carotenoids (blue absorption) peak / highest, at 460 / 465 nm<b> ;</b>",
              "numberedInMs": false
            },
            {
              "n": 9,
              "text": "<b>9 </b> <b> </b> chlorophyll <i>a</i> has blue peak and red peak but carotenoids have two blue peaks and no red peak <b> </b> <b> </b> <b>or</b> chlorophyll <i>a</i> has two peaks but carotenoids have three peaks <b>;</b>",
              "numberedInMs": false
            }
          ]
        },
        "er": [],
        "aiSupplement": {
          "explanation": [
            {
              "text": "An absorption spectrum concerns light absorbed, whereas an action spectrum concerns the effectiveness of wavelengths in driving photosynthesis. Compare the same wavelengths on both curves.",
              "refs": [
                "syllabus:13.1(5)",
                "ms:b#1"
              ]
