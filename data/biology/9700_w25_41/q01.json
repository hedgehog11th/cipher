        "stem": [
          {
            "type": "text",
            "text": "Some genes in guinea pigs are structural genes and some are regulatory genes.",
            "source": {
              "qp": 3
            }
          },
          {
            "type": "text",
            "text": "Describe the difference between a structural gene and a regulatory gene.",
            "source": {
              "qp": 3
            }
          }
        ],
        "marks": 2,
        "topics": [
          {
            "ref": "16.3(1)",
            "role": "primary"
          }
        ],
        "markScheme": {
          "marks": 2,
          "instruction": null,
          "guidance": [],
          "points": [
            {
              "n": 1,
              "text": "<b>1 </b> <b> </b> structural gene codes for, (named) structural / functional, protein / polypeptide <b>; </b>",
              "numberedInMs": false
            },
            {
              "n": 2,
              "text": "<b>2 </b> <b> </b> regulatory gene codes for, transcription factor / repressor protein <b>or  </b> regulatory gene, controls / helps / restricts, expression of (other) genes <b>; </b>",
              "numberedInMs": false
            }
          ]
        },
        "er": [],
        "aiSupplement": {
          "explanation": [
            {
              "text": "Structural genes encode functional products, while regulatory genes encode products that control expression of other genes. Induction changes expression rather than changing the DNA sequence.",
              "refs": [
                "syllabus:16.3(1)",
                "ms:c#1"
              ]
            }
          ],
          "reasoningChain": [
            "Distinguish the gene product from what it controls.",
            "Identify whether the signal activates or represses expression."
          ],
          "inferredMistakes": [
            {
              "text": "Calling a promoter a protein encoded by a structural gene",
              "basis": "inferred",
              "refs": [
                "syllabus:16.3(1)"
              ]
            }
          ]
        },
