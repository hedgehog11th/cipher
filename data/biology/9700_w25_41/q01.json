            "stem": [
              {
                "type": "text",
                "text": "A test cross could be used to determine the genotype of a female guinea pig with short black fur.",
                "source": {
                  "qp": 2
                }
              },
              {
                "type": "text",
                "text": "Describe the <b>phenotype</b> of the male guinea pig that could be used to carry out this test cross.",
                "source": {
                  "qp": 2
                }
              }
            ],
            "marks": 1,
            "topics": [
              {
                "ref": "16.2(4)",
                "role": "primary"
              }
            ],
            "markScheme": {
              "marks": 1,
              "instruction": null,
              "guidance": [],
              "points": [
                {
                  "n": 1,
                  "text": "long chocolate <b>; </b>",
                  "numberedInMs": false
                }
              ]
            },
            "er": [],
            "aiSupplement": {
              "explanation": [
                {
                  "text": "A homozygous recessive tester supplies only recessive alleles. Offspring phenotypes can then reveal alleles masked by dominance in the individual being tested.",
                  "refs": [
                    "syllabus:16.2(4)",
                    "ms:a.ii#1"
                  ]
                }
              ],
              "reasoningChain": [
                "Choose a suitable recessive tester.",
                "Relate each possible offspring class to an allele in the tested parent."
              ],
              "inferredMistakes": [
                {
                  "text": "Using a homozygous dominant individual as the tester",
                  "basis": "inferred",
                  "refs": [
                    "syllabus:16.2(4)"
                  ]
                }
              ]
            },
            "type": "short"
          }
