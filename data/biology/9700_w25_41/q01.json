        "stem": [
          {
            "type": "text",
            "text": "A black guinea pig with long fur that was homozygous at both loci was crossed with a chocolate guinea pig with short fur that was homozygous at both loci. The F1 offspring of this cross had short black fur. F1 offspring were mated together to produce the F2 offspring.",
            "source": {
              "qp": 3
            }
          },
          {
            "type": "text",
            "text": "Complete the Punnett square to:",
            "source": {
              "qp": 3
            }
          },
          {
            "type": "list",
            "items": [
              "show the cross between the F1 offspring",
              "predict the F2 offspring genotypes."
            ]
          },
          {
            "type": "text",
            "text": "You should include the gametes in your answer.",
            "source": {
              "qp": 3
            }
          },
          {
            "type": "text",
            "text": "State the ratio of F2 offspring phenotypes. You should include a key to link phenotypes to genotypes.",
            "source": {
              "qp": 3
            }
          },
          {
            "type": "figure",
            "id": "punnett1",
