        "source": {
          "qp": 19
        },
        "stem": [
          {
            "type": "text",
            "text": "A suspension of <i>Trebouxia</i> in water was used to investigate the effect of the intensity of light on the rate of photosynthesis. The volume of oxygen released over a set period of time was used as a measure of the rate of photosynthesis at each different light intensity.",
            "source": {
              "qp": 19
            }
          },
          {
            "type": "text",
            "text": "All other conditions were kept constant.",
            "source": {
              "qp": 19
            }
          },
          {
            "type": "text",
            "text": "Fig. 8.2 shows how light intensity affected the volume of oxygen released by <i>Trebouxia</i>.",
            "source": {
              "qp": 19
            }
          },
          {
            "type": "figure",
            "id": "fig8.2",
            "caption": "Fig. 8.2",
            "src": "figures/q8_fig8_2.png",
            "alt": "Effect of light intensity on oxygen exchange",
            "source": {
              "qp": 19
            }
          }
        ],
        "parts": [
