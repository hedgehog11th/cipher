        },
        "stem": [
          {
            "type": "text",
            "text": "Some seal species are classified as endangered on the IUCN Red List of Threatened Species<sup>TM</sup>.",
            "source": {
              "qp": 24
            }
          },
          {
            "type": "text",
            "text": "Suggest ways in which seal species may be conserved.",
            "source": {
              "qp": 24
            }
          }
        ],
        "marks": 3,
        "topics": [
          {
            "ref": "18.3(3)",
            "role": "primary"
          }
        ],
        "markScheme": {
          "marks": 3,
          "instruction": "<i>any </i><b><i>three</i></b><i> from: </i>",
          "guidance": [],
          "points": [
            {
              "n": 1,
              "text": "1  (captive) breeding programs / described / frozen zoos <b>; </b>",
              "numberedInMs": false
            },
            {
              "n": 2,
              "text": "2  marine reserves / protected areas <b>; </b>",
              "numberedInMs": false
            },
            {
              "n": 3,
              "text": "3  ban on hunting / trade, (of seals) <b>; </b> <b> </b>",
              "numberedInMs": false
            },
            {
              "n": 4,
              "text": "4  <i>ref. to</i> education / awareness <b>; </b>",
              "numberedInMs": false
            },
            {
              "n": 5,
              "text": "5  research <b>; </b>",
              "numberedInMs": false
            },
            {
              "n": 6,
              "text": "6  reduce, <u>ocean</u> / <u>sea</u>, pollution / described <b>;</b>",
              "numberedInMs": false
            },
            {
              "n": 7,
              "text": "7  reduce fishing <b>;</b>",
              "numberedInMs": false
            },
            {
              "n": 8,
              "text": "8  reduce climate change <b>;</b>",
              "numberedInMs": false
            }
          ]
        },
        "er": [],
        "aiSupplement": {
          "explanation": [
            {
              "text": "A conservation measure must address the species’ threats and biological requirements. Protection is more effective when habitat quality, food, breeding sites and harmful pressures are considered together.",
