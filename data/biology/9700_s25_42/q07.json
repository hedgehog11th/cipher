        "stem": [
          {
            "type": "text",
            "text": "An axon membrane is described as being at its resting potential when an action potential is <b>not</b> occurring.",
            "source": {
              "qp": 15
            }
          },
          {
            "type": "text",
            "text": "Describe <b>and</b> explain how a resting potential of an axon membrane is maintained.",
            "source": {
              "qp": 15
            }
          }
        ],
        "marks": 6,
        "topics": [
          {
            "ref": "15.1(6)",
            "role": "primary"
          }
        ],
        "markScheme": {
          "marks": 6,
          "instruction": "<i>any </i><b><i>six</i></b><i> from: </i>",
          "guidance": [],
          "points": [
            {
              "n": 1,
              "text": "1  sodium–potassium pumps (in axon membrane) <b>;</b>",
              "numberedInMs": false
            },
            {
              "n": 2,
              "text": "2  transport, sodium ions / Na<sup>+</sup>, out and, potassium ions / K<sup>+</sup>, in <b>;</b>",
              "numberedInMs": false
            },
            {
              "n": 3,
              "text": "3  by active transport / uses ATP <b>;</b>",
              "numberedInMs": false
            },
            {
              "n": 4,
              "text": "4  <u>three</u>, sodium ions / Na<sup>+</sup>, and <u>two</u>, potassium ions / K<sup>+</sup> <b>;</b> <b> </b>",
              "numberedInMs": false
            },
            {
              "n": 5,
              "text": "5  sets up an electrochemical gradient <b>;</b>",
              "numberedInMs": false
            },
            {
              "n": 6,
              "text": "6  potassium ions / K<sup>+</sup>, diffuse out through channels <b>;</b>",
              "numberedInMs": false
            },
            {
              "n": 7,
              "text": "7  membrane more permeable to K<sup>+</sup> / membrane has more K<sup>+</sup> channels <b>; </b>",
              "numberedInMs": false
            },
            {
              "n": 8,
              "text": "8  (so) more, potassium ions / K<sup>+</sup>, move out of axon than, sodium ions / Na<sup>+</sup>, move in <b>;</b>",
              "numberedInMs": false
            },
            {
              "n": 9,
              "text": "9  <i>ref. to</i> anions / negatively charged ions / negatively charged proteins, inside <b>;</b>",
              "numberedInMs": false
            },
            {
              "n": 10,
              "text": "10 inside negative (relative to outside) <b>; </b>",
              "numberedInMs": false
            },
            {
              "n": 11,
              "text": "11 -60 mV to -70 mV <b>;</b>",
              "numberedInMs": false
            }
          ]
        },
        "er": [],
        "aiSupplement": {
          "explanation": [
            {
              "text": "Membrane potential depends on ion gradients and selective permeability. Ion movement through channels and maintenance of gradients by the sodium–potassium pump have different roles.",
              "refs": [
                "syllabus:15.1(6)",
                "ms:a#1"
              ]
