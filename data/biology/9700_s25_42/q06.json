        },
        "er": [],
        "aiSupplement": {
          "explanation": [
            {
              "text": "Changes in guard-cell solute content alter water potential, water movement and turgor. Uneven wall properties translate a change in turgor into a change in stomatal aperture.",
              "refs": [
                "syllabus:14.2(3)",
                "ms:a#1"
              ]
            }
          ],
          "reasoningChain": [
            "Relate guard-cell structure to deformation.",
            "Trace ion movement, water movement and the resulting aperture."
          ],
          "inferredMistakes": [
            {
              "text": "Claiming that water enters guard cells by active transport",
              "basis": "inferred",
              "refs": [
                "syllabus:14.2(3)"
              ]
            }
          ]
        },
        "type": "short"
      },
