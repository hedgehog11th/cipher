            "stem": [
              {
                "type": "text",
                "text": "Calculate the mean rate of decrease in the Sumatran tiger population between 1970 and 2020."
              },
              {
                "type": "answerLines",
                "labels": [
                  "mean rate of decrease (year<sup>–1</sup>) ="
                ]
              }
            ],
            "topics": [
              {
                "ref": "18.3(1)",
                "role": "primary"
              }
            ],
            "markScheme": {
              "marks": 2,
              "instruction": null,
              "guidance": [],
              "points": [
                {
                  "n": 1,
                  "text": "10.8 (year<sup>–1</sup>) <b>; ;</b>",
                  "numberedInMs": false
                }
              ],
              "after": [
                "if value for rate is incorrect <b>allow</b> 1 mark for:<br>(1010 – 470) / 50 <b>or</b> 540 / 50"
              ],
              "source": {
                "ms": 14
              },
              "note": "The MS prints the working as two stacked fractions; written here on one line with “/”. Point 1 carries both marks (“; ;”)."
            },
            "er": [
              "er.q7.a.i"
            ],
            "aiSupplement": {
              "explanation": [
                {
                  "text": "Read the two end points from Fig. 7.2: about 1010 tigers in 1970 and about 470 in 2020. The decrease is 1010 – 470 = 540 tigers over 2020 – 1970 = 50 years, so the mean rate of decrease is 540 ÷ 50 = 10.8 tigers per year.",
                  "refs": [
                    "ms:a.i#1"
                  ]
                },
                {
                  "text": "The calculation step itself has no syllabus outcome of its own; it is tagged to 18.3(1), the outcome on why populations can become extinct, because the data show a falling population of an endangered species.",
                  "refs": [
                    "syllabus:18.3(1)"
                  ]
                }
              ],
              "reasoningChain": [
                "Read the 1970 value (about 1010) and the 2020 value (about 470) from the graph.",
                "Find the decrease: 1010 – 470 = 540.",
                "Find the time: 2020 – 1970 = 50 years.",
                "Divide: 540 ÷ 50 = 10.8 per year."
              ],
              "inferredMistakes": [
                {
                  "text": "Reading 1000 instead of about 1010 for 1970: the 1970 point sits just above the 1000 line.",
                  "basis": "inferred",
                  "refs": [
                    "ms:a.i#1"
                  ]
                },
                {
                  "text": "Dividing by 5 (the number of decades) instead of by 50 years.",
                  "basis": "inferred",
                  "refs": [
                    "ms:a.i#1"
                  ]
                }
              ]
            }
          },
          {
            "key": "a.ii",
            "label": "(ii)",
            "type": "short",
            "marks": 3,
