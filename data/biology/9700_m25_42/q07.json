        },
        "stem": [
          {
            "type": "text",
            "text": "Fig. 7.2 shows the number of wild Sumatran tigers in the world between 1970 and 2020."
          },
          {
            "type": "figure",
            "id": "fig7.2",
            "caption": "Fig. 7.2",
            "src": "figures/q7_fig7_2.png",
            "alt": "Line graph on a grid. x-axis: year, 1970 to 2020. y-axis: number of Sumatran tigers, 0 to 1200. Points joined by straight lines: about 1010 in 1970, 1000 in 1980, 850 in 1990, 750 in 2000, 600 in 2010 and 470 in 2020.",
            "source": {
              "qp": 22
            }
          }
        ],
        "parts": [
          {
