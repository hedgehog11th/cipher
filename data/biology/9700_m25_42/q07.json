    "stem": [
      {
        "type": "text",
        "text": "The Sumatran tiger, <i>Panthera tigris sumatrae</i>, is classified as critically endangered on the International Union for Conservation of Nature (IUCN) Red List of Threatened Species<sup>TM</sup>.",
        "source": {
          "qp": 22
        }
      },
      {
        "type": "text",
        "text": "Fig. 7.1 shows a Sumatran tiger.",
        "source": {
          "qp": 22
        }
      },
      {
        "type": "figure",
        "id": "fig7.1",
        "caption": "Fig. 7.1",
        "src": "figures/q7_fig7_1.png",
