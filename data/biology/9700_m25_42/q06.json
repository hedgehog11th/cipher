          {
            "type": "figure",
            "id": "fig6.1",
            "caption": "Fig. 6.1",
            "src": "figures/q6_fig6_1.png",
            "alt": "Flow chart: meal rich in carbohydrates, then increase in blood glucose concentration above the set point, then pancreas releases P. P stimulates glucose uptake in fat cells and Q cells, and P stimulates liver cells to convert glucose to R. Both lead to a decrease in blood glucose concentration.",
            "source": {
              "qp": 20
            }
          }
        ],
