            ],
            "aiSupplement": {
              "explanation": [
                {
                  "text": "The response (a decrease in blood glucose) reverses the original change (an increase above the set point), which is the definition of negative feedback.",
                  "refs": [
                    "ms:a.ii#1",
                    "syllabus:14.1(2)"
                  ]
                }
              ],
              "reasoningChain": [
                "Compare the start and the end of the flow chart: glucose rises, and the outcome is a decrease.",
                "A response that opposes the change and returns the value towards the set point is negative feedback."
              ],
