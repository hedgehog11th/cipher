            ],
            "aiSupplement": {
              "explanation": [
                {
                  "text": "A rise in blood glucose above the set point makes the pancreas release insulin. Insulin increases glucose uptake by fat cells and muscle cells, and makes liver cells store glucose by converting it to glycogen.",
                  "refs": [
                    "ms:a.i#1",
                    "ms:a.i#2",
                    "ms:a.i#3",
                    "syllabus:14.1(10)"
                  ]
                }
              ],
              "reasoningChain": [
                "The hormone released when glucose rises above the set point is insulin (P).",
                "Besides fat cells, insulin stimulates glucose uptake by muscle cells (Q).",
                "The storage compound that liver cells make from glucose is glycogen (R)."
              ],
              "inferredMistakes": [
                {
                  "text": "Naming R as glucagon instead of glycogen, confusing the hormone with the storage polysaccharide.",
                  "basis": "inferred",
                  "refs": [
                    "ms:a.i#3"
                  ]
                }
              ]
            }
          },
