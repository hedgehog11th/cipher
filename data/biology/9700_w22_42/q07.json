    "stem": [
      {
        "type": "text",
        "text": "The determination of sex in domestic turkeys is different from that in humans. The sex chromosomes in turkeys are named <b>Z</b> and <b>W</b>. Male turkeys are <b>ZZ</b> and female turkeys are <b>ZW</b>.",
        "source": {
          "qp": 20
        }
      },
      {
        "type": "text",
        "text": "The gene for feather colour is located only on the <b>Z</b> chromosome.",
        "source": {
          "qp": 20
        }
      },
      {
        "type": "list",
        "items": [
          "The dominant allele codes for bronze feathers.",
          "The recessive allele codes for brown feathers."
        ],
        "source": {
          "qp": 20
        }
      }
    ],
    "parts": [
