          "points": [
            {
              "n": 1,
              "text": "<i>dominant</i> – allele always has effect on phenotype / allele expressed in homozygote and heterozygote / allele always expressed <b>;</b>",
              "numberedInMs": false
            },
            {
              "n": 2,
              "text": "<i>recessive</i> – allele only has effect on phenotype if dominant allele absent / only expressed in homozygote <b>;</b>",
              "numberedInMs": false
            }
          ],
          "source": {
            "ms": 16
          }
