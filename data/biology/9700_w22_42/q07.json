            {
              "n": 1,
              "text": "cross with brown female <b>; </b>"
            },
            {
              "n": 2,
              "text": "if <b>all</b> offspring bronze then male is, homozygous / <b>Z<sup>B</sup>Z<sup>B</sup> ; </b>"
            },
            {
              "n": 3,
              "text": "if (some offspring are bronze and) some are brown then male is, heterozygous / <b>Z<sup>B</sup>Z<sup>b</sup></b> <b>;</b>"
