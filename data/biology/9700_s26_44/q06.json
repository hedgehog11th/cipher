              "marks": 2,
              "instruction": null,
              "guidance": [],
              "points": [
                {
                  "n": 1,
                  "text": "light <u>intensity</u> no longer limiting <b>; </b>"
                },
                {
                  "n": 2,
                  "text": "carbon dioxide <u>concentration</u> / temperature, now limiting <b>; </b>"
                }
              ],
              "source": {
