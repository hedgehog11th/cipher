              "ms": 15
            },
            "stem": [
              {
                "type": "text",
                "text": "People with type 1 diabetes need daily injections of insulin. Insulin used to be obtained by extracting it from farm animals. Now it is made artificially using genetic technology and has the same amino acid sequence as human insulin.",
                "source": {
                  "qp": 12
                }
              },
              {
                "type": "text",
                "text": "Explain the advantages of producing insulin, with the same amino acid sequence as human insulin, by genetic technology rather than obtaining it from farm animals.",
                "source": {
                  "qp": 12
                }
              }
            ],
            "marks": 3,
            "markScheme": {
              "marks": 3,
              "instruction": "<i>any <b>three</b> from:</i><br><i>identical to human insulin</i>",
              "guidance": [],
              "points": [
                {
                  "n": 1,
                  "text": "no, allergy / immune response / antibody response / side effects / rejection <b>;</b>"
                },
                {
                  "n": 2,
                  "text": "acts rapidly <b>;</b>"
                },
                {
                  "n": 3,
                  "text": "do not, develop tolerance to it / need larger doses <b>;</b>"
                },
                {
                  "n": 4,
                  "text": "no risk of, disease / infection <b>;</b>"
                },
                {
                  "n": 5,
                  "text": "no / fewer, (named) ethical issues <b>;</b>"
                }
              ],
              "source": {
                "ms": 15
              },
              "note": "Point n follows the order of the transcribed marking points; table rows or source labels such as 3a and 3b retain their original wording."
            },
            "topics": [
              {
                "ref": "19.2(1)",
                "role": "primary"
              }
            ],
            "er": [],
            "aiSupplement": {
              "explanation": [
                {
                  "text": "Matching the human amino acid sequence reduces the chance of an immune response. Controlled microbial production also avoids dependence on animal tissues and permits supply to be scaled.",
                  "refs": [
                    "ms:b.ii#1",
                    "ms:b.ii#2",
                    "ms:b.ii#3",
                    "ms:b.ii#4",
