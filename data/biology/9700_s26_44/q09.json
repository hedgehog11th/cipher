        "stem": [
          {
            "type": "text",
            "text": "The Venus fly trap, <i>Dionaea muscipula</i>, is a carnivorous plant that captures small insects in a trap made from a specialised leaf.",
            "source": {
              "qp": 20
            }
          }
        ],
        "parts": [
          {
            "key": "a.i",
            "label": "(i)",
            "source": {
              "qp": 20,
              "ms": 20
            },
            "stem": [
              {
                "type": "text",
                "text": "The first step in capturing an insect occurs when the insect touches at least two sensory hairs on the leaf of the plant within 35 seconds. The second step occurs when an action potential is produced and spreads over the leaf.",
                "source": {
                  "qp": 20
                }
              },
              {
                "type": "text",
                "text": "Outline how the stimulation of sensory hair cells of a Venus fly trap plant leads to an insect being trapped.",
                "source": {
                  "qp": 20
                }
              }
            ],
            "marks": 4,
            "markScheme": {
              "marks": 4,
              "instruction": "<i>any </i><b><i>four</i></b><i> from: </i>",
              "guidance": [],
              "points": [
                {
                  "n": 1,
                  "text": "H<sup>+</sup> pumped out of, hinge / midrib, cells<br><b>or</b><br>H<sup>+</sup> pumped into cell walls <b>; </b>"
                },
                {
                  "n": 2,
                  "text": "cell wall, loosens / cross-links broken <b>; </b>"
                },
                {
                  "n": 3,
                  "text": "calcium pectate dissolves <b>; </b>"
                },
                {
                  "n": 4,
                  "text": "Ca<sup>2+</sup> enter cells <b>; </b>"
                },
                {
                  "n": 5,
                  "text": "water enters by osmosis <b>; </b>"
                },
                {
                  "n": 6,
                  "text": "cells, expand / become turgid <b>; </b>"
                },
                {
                  "n": 7,
                  "text": "(lobes) change from convex to concave<b> ; </b>"
                }
              ],
              "source": {
                "ms": 20
              },
              "note": "Point n follows the order of the transcribed marking points; table rows or source labels such as 3a and 3b retain their original wording."
            },
            "topics": [
