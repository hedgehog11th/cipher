        },
        "stem": [
          {
            "type": "text",
            "text": "In 2018, an area of 123.5 million hectares was used to grow soybean crops worldwide. GM soybean was grown in 73% of this area.",
            "source": {
              "qp": 6
            }
          },
          {
            "type": "text",
            "text": "In 2018, soybeans accounted for 50% of the total GM crop area worldwide.",
            "source": {
              "qp": 6
            }
          },
          {
            "type": "text",
            "text": "Calculate the total area used to grow GM crops worldwide in 2018.",
            "source": {
              "qp": 6
            }
          },
          {
            "type": "text",
            "text": "Show your working.",
            "source": {
              "qp": 6
            }
          }
        ],
        "marks": 2,
        "topics": [
