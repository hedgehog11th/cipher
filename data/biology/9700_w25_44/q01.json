        "aiSupplement": {
          "explanation": [
            {
              "text": "Neurone structures have roles in receiving input, conducting impulses and forming output synapses. Identify labels from their location along the cell rather than their shape alone.",
              "refs": [
                "syllabus:15.1(3)",
                "ms:a#1"
