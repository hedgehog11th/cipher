        "stem": [
          {
            "type": "text",
            "text": "Explain, using examples, why the homeostatic control involving the opening and closing of stomata is important for the efficient functioning of plants.",
            "source": {
              "qp": 23
            }
          }
        ],
        "marks": 4,
        "topics": [
          {
            "ref": "14.2(1)",
            "role": "primary"
          }
        ],
        "markScheme": {
          "marks": 4,
          "instruction": "<i>any </i><b><i>four</i></b><i> from: </i>",
          "guidance": [],
          "points": [
            {
              "n": 1,
              "text": "<b>1</b>  (stomata) open to take up carbon dioxide for photosynthesis <b>; </b>",
              "numberedInMs": false
            },
            {
              "n": 2,
              "text": "<b>2</b>  (stomata) close to prevent, transpiration / (excessive) water loss <b>; </b>",
              "numberedInMs": false
            },
            {
              "n": 3,
              "text": "<b>3</b>  e.g. conditions when stomata close <b>;  </b>",
              "numberedInMs": false
            },
            {
              "n": 4,
              "text": "<b>4</b>  (water homeostasis needed to) maintain turgidity of cells / supply water for reactions <b>; </b>",
              "numberedInMs": false
            },
            {
              "n": 5,
              "text": "<b>5</b>  <i>ref. to</i> daily rhythm <b>or</b> open during, day / light, and close, at night / at low light intensity / in the dark <b>;</b>",
              "numberedInMs": false
            },
            {
