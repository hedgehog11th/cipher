        "stem": [
          {
            "type": "text",
            "text": "Meiosis and cytokinesis occur in the male reproductive organs (anthers) of plants to make pollen grains. Cells which carry out meiosis are known as pollen mother cells.",
            "source": {
              "qp": 4
            }
          },
          {
            "type": "text",
            "text": "Fig. 2.1 shows five stages of meiosis in a pollen mother cell.",
            "source": {
              "qp": 4
            }
          },
          {
            "type": "figure",
            "id": "fig2.1",
            "caption": "Fig. 2.1",
            "src": "figures/q2_fig2_1.png",
            "alt": "Stages of meiosis",
            "source": {
              "qp": 4
            }
          },
          {
            "type": "text",
            "text": "Use the letters <b>J</b>–<b>N</b> in Fig. 2.1 to state <b>all</b> the stages that show:",
            "source": {
              "qp": 4
            }
          },
          {
            "type": "answerLines",
            "labels": [
              "anaphase",
              "cells containing pairs of homologous chromosomes",
              "crossing over",
              "haploid cells"
            ]
          }
