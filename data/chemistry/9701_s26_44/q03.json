        "aiSupplement": {
          "explanation": [
            {
              "text": "The order with respect to a reactant is its power in the rate equation. In rate = <i>k</i>[NO<sub>2</sub>][F<sub>2</sub>] both concentrations have no written power, which means a power of 1. So the reaction is first order in NO<sub>2</sub>, first order in F<sub>2</sub>, and 1 + 1 = second order overall. The coefficient 2 in front of NO<sub>2</sub> in the balanced equation does not set the order.",
              "refs": [
                "ms:a#1",
                "syllabus:26.1(1)",
                "syllabus:26.1(2)"
              ]
            }
          ],
          "reasoningChain": [
            "Power of [NO₂] in the rate equation: 1.",
            "Power of [F₂]: 1.",
            "Overall order = 1 + 1 = 2."
          ],
          "inferredMistakes": [
            {
              "text": "Taking the order in NO₂ as 2 from the coefficient in the balanced equation, which gives an overall order of 3.",
              "basis": "inferred",
              "refs": [
                "ms:a#1"
              ]
            }
          ]
        }
