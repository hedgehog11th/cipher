                "role": "primary"
              },
              {
                "ref": "24.1(3)",
                "role": "secondary"
              }
            ],
            "markScheme": {
              "marks": 1,
              "instruction": null,
              "guidance": [
                "<b>ECF</b> from <b>1(b)(i)</b>, e.g. if mol in <b>1(b)(i)</b> = 0.0179, volume = 0.962.",
                "0.482 if 0.00897 mol.",
                "0.484 if 0.0090 mol.",
                "0.962 if 0.0179 mol.",
                "<b>A</b> use of their unrounded previous value, e.g. 0.962 if 0.018 mol (i.e. they are <i>using</i> 0.0179).",
                "correct answer [1]."
              ],
              "points": [
                {
                  "n": 1,
                  "text": "V = nRT / p → (<b>1(b)(i)</b> × 8.31 × 653) / 101 000 = 4.81 × 10<sup>–4</sup> m<sup>3</sup>",
                  "numberedInMs": false
                },
                {
                  "n": 2,
                  "text": "4.81×10<sup>–4</sup> m<sup>3</sup> × 1000 = <b>0.481</b> (dm<sup>3</sup>)<br><b>answer must be 3sf</b>",
                  "numberedInMs": false
                }
              ],
              "source": {
                "ms": 7
              }
            },
            "er": [],
            "aiSupplement": {
              "explanation": [
                {
                  "text": "Rearrange <i>pV</i> = <i>nRT</i> to <i>V</i> = <i>nRT</i>/<i>p</i> and use SI units throughout: <i>p</i> in Pa (101 kPa = 101 000 Pa) and <i>T</i> in K (380 + 273 = 653 K). The volume then comes out in m<sup>3</sup>: 0.00895 × 8.31 × 653 / 101 000 = 4.81 × 10<sup>–4</sup> m<sup>3</sup>. Multiply by 1000 to convert to dm<sup>3</sup>: 0.481 dm<sup>3</sup>, given to three significant figures as the question asks.",
