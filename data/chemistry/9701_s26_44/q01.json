          "points": [
            {
              "n": 1,
              "text": "Full expression:<br><b>M1</b> (36 000 × 23) / (1.6 × 10<sup>–19</sup> × 8.51) = 6.08 × 1023 (mol<sup>–1</sup>)",
              "numberedInMs": false
            },
            {
              "n": 2,
              "text": "36 000 ÷ 1.6 × 10<sup>–19</sup> <b>or 2.25 × 10<sup>23</sup></b> electrons / atoms Na",
