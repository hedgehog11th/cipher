              "guidance": [],
              "points": [
                {
                  "n": 1,
                  "text": "2bi<sup>2</sup> / 0.105 0.00126<sup>2</sup> / 0.105 ecf bi 1.5 × 10<sup>–5</sup> / 1.51 × 10<sup>–5</sup> / 1.53 × 10<sup>–5</sup> ecf",
