            "er": [],
            "aiSupplement": {
              "explanation": [
                {
                  "text": "For a weak acid HA ⇌ H<sup>+</sup> + A<sup>–</sup>, <i>K</i><sub>a</sub> = [H<sup>+</sup>][A<sup>–</sup>] / [HA]. Each molecule that dissociates gives one H<sup>+</sup> and one A<sup>–</sup>, so [A<sup>–</sup>] = [H<sup>+</sup>]. Only a tiny fraction dissociates, so [HA] is taken as the original 0.105 mol dm<sup>–3</sup>. <i>K</i><sub>a</sub> = (1.26 × 10<sup>–3</sup>)<sup>2</sup> / 0.105 = 1.51 × 10<sup>–5</sup> mol dm<sup>–3</sup>. The answer to (b)(i) is carried forward (ecf).",
                  "refs": [
                    "ms:b.ii#1",
                    "syllabus:25.1(3)",
                    "syllabus:25.1(4)"
                  ]
                }
              ],
              "reasoningChain": [
                "Write Ka = [H⁺][A⁻]/[HA].",
                "Use [A⁻] = [H⁺] = 1.26 × 10⁻³ and [HA] ≈ 0.105.",
                "Ka = (1.26 × 10⁻³)² / 0.105 = 1.51 × 10⁻⁵."
              ],
              "inferredMistakes": [
                {
                  "text": "Forgetting to square [H⁺], giving 1.2 × 10⁻².",
                  "basis": "inferred",
                  "refs": [
                    "ms:b.ii#1"
                  ]
                },
                {
                  "text": "Using the pH (2.90) instead of [H⁺] in the Ka expression.",
                  "basis": "inferred",
                  "refs": [
                    "ms:b.ii#1"
                  ]
                }
              ]
            }
