                  "basis": "inferred",
                  "refs": [
                    "ms:a.i#1"
                  ]
                },
                {
                  "text": "Leaving out the minus sign.",
                  "basis": "inferred",
                  "refs": [
                    "ms:a.i#1"
                  ]
                }
              ]
            }
