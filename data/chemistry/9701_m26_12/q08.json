        "aiSupplement": {
          "explanation": [
            {
              "text": "ΔH = (energy needed to break the bonds in the reactants) − (energy released making the bonds in the products). The reactants contain 3 H–H bonds and 1 N≡N bond; the products, 2NH<sub>3</sub>, contain 6 N–H bonds.",
              "refs": [
                "syllabus:5.1(5)"
              ]
            },
            {
              "text": "–92.2 = (3 × 436 + E(N≡N)) − (6 × 388) = 1308 + E(N≡N) − 2328, so E(N≡N) = 2328 − 1308 − 92.2 = 927.8 ≈ 928 kJ mol<sup>–1</sup>.",
              "refs": [
                "syllabus:5.1(5)"
              ]
            }
          ],
          "optionAnalysis": [
            {
              "key": "A",
              "correct": false,
              "text": "Too small for a triple bond (smaller than the single H–H bond); it does not satisfy the bond-energy balance with 3 H–H broken and 6 N–H formed."
            },
            {
              "key": "B",
              "correct": true,
              "text": "Correct. 1308 + E(N≡N) − 2328 = –92.2 gives E(N≡N) = 928 kJ mol<sup>–1</sup>."
            },
            {
              "key": "C",
              "correct": false,
              "text": "Does not satisfy the bond-energy balance; it typically comes from a sign error with ΔH or from miscounting the N–H bonds in 2NH<sub>3</sub>."
            },
            {
              "key": "D",
              "correct": false,
              "text": "Does not satisfy the bond-energy balance; it comes from miscounting the bonds broken or formed, or from reversing bonds broken minus bonds formed."
            }
          ],
          "reasoningChain": [
            "Bonds broken: 3 H–H + 1 N≡N = 3 × 436 + E = 1308 + E.",
            "Bonds formed: 2NH<sub>3</sub> has 6 N–H = 6 × 388 = 2328.",
            "ΔH = broken − formed: –92.2 = 1308 + E − 2328.",
            "E = 2328 − 1308 − 92.2 = 927.8 ≈ 928 kJ mol<sup>–1</sup>."
          ],
